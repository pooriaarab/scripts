@@ -0,0 +1,16 @@
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+
+const execFileAsync = promisify(execFile);
+
+/**
+ * Launch an app with CoreDevice, not WDA. On iOS 27 beta, WDA `activateApp`
+ * reports the app as foreground while SpringBoard stays on screen.
+ * `devicectl` always brings the app to the front.
+ */
+export async function launchAppViaDevicectl(udid: string, bundleId: string, options: { terminateExisting?: boolean } = {}): Promise<void> {
+    const args = ['devicectl', 'device', 'process', 'launch', '--device', udid];
+    if (options.terminateExisting) args.push('--terminate-existing');
+    args.push(bundleId);
+    await execFileAsync('xcrun', args, { timeout: 60_000, env: { ...process.env, ...(process.env.XCODE_DEVELOPER_DIR ? { DEVELOPER_DIR: process.env.XCODE_DEVELOPER_DIR } : {}) } });
+}
