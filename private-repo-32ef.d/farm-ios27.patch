diff --git a/src/tiktok/human-gesture.ts b/src/tiktok/human-gesture.ts
new file mode 100644
index 0000000..d5e9d06
--- /dev/null
+++ b/src/tiktok/human-gesture.ts
@@ -0,0 +1,108 @@
+/**
+ * Human-like next-video swipe.
+ *
+ * A bot swipe is one straight line: same X, same start and end Y, same
+ * duration, constant speed. A finger drifts sideways, bows the path, starts
+ * and ends at different heights, and speeds up then slows down. This builds
+ * a W3C pointer action list with those traits.
+ *
+ * Touch pressure is not modelled: XCTest synthesized touches carry no force
+ * on this hardware.
+ */
+
+export interface HumanSwipeInput {
+    /** Left-third axis the gesture stays near, so it does not turn a carousel sideways. */
+    axisX: number;
+    startY: number;
+    endY: number;
+    durationMs: number;
+    screenWidth: number;
+    screenHeight: number;
+    /** Injectable for repeatable output. Defaults to Math.random. */
+    random?: () => number;
+}
+
+export type PointerStep =
+    | { type: 'pointerMove'; duration: number; x: number; y: number }
+    | { type: 'pointerDown'; button: 0 }
+    | { type: 'pointerUp'; button: 0 }
+    | { type: 'pause'; duration: number };
+
+/** Approximate normal sample (sum of uniforms), mean 0, sd about 1. */
+function gaussian(random: () => number): number {
+    let sum = 0;
+    for (let i = 0; i < 6; i += 1) sum += random();
+    return (sum - 3) / Math.sqrt(0.5);
+}
+
+function clamp(value: number, min: number, max: number): number {
+    return Math.min(max, Math.max(min, value));
+}
+
+/**
+ * Speed profile: blend of ease-in-out and ease-out. `skew` near 1 is a flick
+ * (fast start, long tail). Near 0 is a slow, even drag.
+ */
+function progress(t: number, skew: number): number {
+    const easeInOut = t * t * (3 - 2 * t);
+    const easeOut = 1 - (1 - t) * (1 - t);
+    return easeInOut * (1 - skew) + easeOut * skew;
+}
+
+export function humanSwipeSteps(input: HumanSwipeInput): PointerStep[] {
+    const random = input.random ?? Math.random;
+    const margin = 12;
+
+    const startX = clamp(input.axisX + gaussian(random) * 5, margin, input.screenWidth - margin);
+    const startY = clamp(input.startY + (random() - 0.5) * 50, margin, input.screenHeight - margin);
+    // Travel 85% to 110% of the planned distance.
+    const planned = input.startY - input.endY;
+    const travel = planned * (0.85 + random() * 0.25);
+    const endY = clamp(startY - travel, margin, input.screenHeight - margin);
+    // Sideways drift of a thumb or finger: a few points either way.
+    const endX = clamp(startX + gaussian(random) * 7, margin, input.screenWidth - margin);
+    // Perpendicular bow in the middle of the stroke.
+    const bow = (random() < 0.5 ? -1 : 1) * (2 + random() * 7);
+
+    // 70% to 135% of the planned duration, never below 180 ms.
+    const total = Math.max(180, Math.round(input.durationMs * (0.7 + random() * 0.65)));
+    const skew = 0.25 + random() * 0.6;
+    const segments = 9 + Math.floor(random() * 4);
+    // A short hesitation mid-stroke on about one swipe in eight.
+    const hesitateAt = random() < 0.12 ? 3 + Math.floor(random() * (segments - 5)) : -1;
+
+    const steps: PointerStep[] = [
+        { type: 'pointerMove', duration: 0, x: Math.round(startX), y: Math.round(startY) },
+        { type: 'pointerDown', button: 0 },
+        // Finger rests on the glass before it moves.
+        { type: 'pause', duration: 30 + Math.floor(random() * 110) },
+    ];
+
+    // Time per segment is even and independent of position. Position follows the
+    // speed profile, so segments that cover more distance move faster.
+    for (let i = 1; i <= segments; i += 1) {
+        const s = progress(i / segments, skew);
+        const x = startX + (endX - startX) * s + bow * Math.sin(Math.PI * s);
+        const y = startY + (endY - startY) * s;
+        const duration = Math.max(8, Math.round((total / segments) * (0.9 + random() * 0.2)));
+        steps.push({
+            type: 'pointerMove',
+            duration,
+            x: Math.round(clamp(x, margin, input.screenWidth - margin)),
+            y: Math.round(clamp(y, margin, input.screenHeight - margin)),
+        });
+        if (i === hesitateAt) steps.push({ type: 'pause', duration: 50 + Math.floor(random() * 120) });
+    }
+    steps.push({ type: 'pointerUp', button: 0 });
+    return steps;
+}
+
+/**
+ * Dwell time between actions. Log-normal: mostly near the median with an
+ * occasional long pause, unlike a flat uniform range.
+ */
+export function humanDwellMs(medianMs: number, random: () => number = Math.random): number {
+    const sigma = 0.45;
+    const value = medianMs * Math.exp(gaussian(random) * sigma);
+    return Math.round(clamp(value, medianMs * 0.4, medianMs * 3.5));
+}
