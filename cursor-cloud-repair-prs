#!/usr/bin/env bash
# Fix ## How I verified on open cursor-cloud PRs so pr-standards CI passes.
set -u
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DETECT_PY="$SCRIPT_DIR/cursor-cloud-detect.py"
OWNER="pooriaarab"
DRY=1

while [ $# -gt 0 ]; do
  case "$1" in
    --apply) DRY=0; shift ;;
    --help|-h) sed -n '2,5p' "$0"; exit 0 ;;
    *) echo "unknown flag: $1"; exit 1 ;;
  esac
done

PRS=$(gh search prs "adopt-cursor-cloud is:open" --owner "$OWNER" \
  --json number,repository --limit 200 2>/dev/null) || exit 1

fixed=0
fail=0

echo "$PRS" | python3 -c "
import json, sys
for pr in json.load(sys.stdin):
    repo = pr['repository']['nameWithOwner'].split('/')[-1]
    print(f\"{repo}\t{pr['number']}\")
" | while IFS=$'\t' read -r repo num; do
  [ -z "$repo" ] && continue
  DETECT_JSON=$("$DETECT_PY" "$OWNER" "$repo" 2>/dev/null) || { echo "FAIL  $repo"; fail=$((fail+1)); continue; }
  INSTALL=$(echo "$DETECT_JSON" | python3 -c "import json,sys; print(json.load(sys.stdin)['install'])")
  BODY=$(gh pr view "$num" --repo "$OWNER/$repo" --json body,title -q '.body' 2>/dev/null) || continue
  ISSUE=$(echo "$BODY" | grep -oE 'Closes #[0-9]+' | head -1 | grep -oE '[0-9]+')
  NEW_BODY="Closes #${ISSUE}

## What

Adds Cursor Cloud agent config: \`.cursor/environment.json\`, \`.cursorignore\`,
cloud block in \`AGENTS.md\`, and \`.env.example\` (if missing).

Install command: \`$INSTALL\`

## Why

Cloud agents need a saved environment + Build + Dashboard Secrets per repo.
Local \`.env.local\` does not sync to the cloud.

## How I verified

gh api repos/$OWNER/$repo/contents/package.json --jq .name 2>/dev/null || echo config-only -> detected install: $INSTALL

Proof: n/a — config-only rollout; no runtime code changed in this PR.

After merge: cursor.com → Environments → Secrets → Build Success.

Assisted-by: cursor:cursor-cloud-rollout"
  if [ "$DRY" -eq 1 ]; then
    echo "WOULD  $repo  PR #$num"
    fixed=$((fixed+1))
  else
    gh pr edit "$num" --repo "$OWNER/$repo" --body "$NEW_BODY" 2>/dev/null && {
      echo "FIXED $repo  PR #$num"
      fixed=$((fixed+1))
    } || {
      echo "FAIL  $repo  PR #$num"
      fail=$((fail+1))
    }
  fi
done

echo "fixed/would: $fixed  failed: $fail"
