#!/usr/bin/env bash
# Devin, non-interactive.
#
# --permission-mode dangerous is required: `accept-edits` approves file edits
# and nothing else, so a brief that has to run its own tests stops on the first
# shell call and the process STILL EXITS 0 -- a success code, no work, and a
# warning on stderr that is easy to miss.
#
# The prompt goes after `--`, per `devin [OPTIONS] [PATH]... [-- <PROMPT>...]`.
# Passing it as an argument to `-p` fails.
#
# THE SECRETS FILE MUST NOT BE SOURCED. Devin authenticates from the OAuth in
# ~/.local/share/devin/credentials.toml. The DEVIN_API_KEY, DEVIN_TOKEN and
# WINDSURF_API_KEY in .secrets/devin.env OVERRIDE that OAuth, and every call
# then returns:
#
#   { "cognition.ai/errorKind": "resource_exhausted", "retryable": true }
#
# which reads as an exhausted quota and is an auth failure. So those three are
# unset here rather than loaded, and a resource_exhausted reply from a clean
# environment is a real account limit.
set -uo pipefail
BIN="$HOME/.local/bin/devin"
dir="${1:?usage: w-devin <dir> "<prompt>" [model]}"; prompt="${2:?prompt required}"
model="${3:-swe-1-7}"

[ -x "$BIN" ] || { echo "w-devin: no binary at $BIN" >&2; exit 127; }

cd "$dir" || exit 1
out=$(env -u DEVIN_API_KEY -u DEVIN_TOKEN -u WINDSURF_API_KEY \
        "$BIN" --model "$model" --respect-workspace-trust false \
        --permission-mode dangerous -p -- "$prompt" 2>&1); status=$?
printf '%s\n' "$out"
if printf '%s' "$out" | grep -q resource_exhausted; then
  echo "w-devin: resource_exhausted from a clean environment, so this is the" >&2
  echo "         account's own limit and is retryable. If you see it after" >&2
  echo "         sourcing .secrets/devin.env, that is the auth trap instead." >&2
  exit 75
fi
exit "$status"
