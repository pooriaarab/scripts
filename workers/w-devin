#!/usr/bin/env bash
# Devin, non-interactive.
#
# --permission-mode dangerous is required: without it every write is refused and
# the process STILL EXITS 0, so a job reads as done having changed nothing.
#
# A resource_exhausted reply is the account's quota, not a broken invocation.
# It is surfaced rather than swallowed, and it is retryable.
set -uo pipefail
BIN="$HOME/.local/bin/devin"
SECRETS="$HOME/Documents/Personal/.secrets/devin.env"
dir="${1:?usage: w-devin <dir> "<prompt>" [model]}"; prompt="${2:?prompt required}"
model="${3:-swe-1-7}"

[ -x "$BIN" ] || { echo "w-devin: no binary at $BIN" >&2; exit 127; }
[ -r "$SECRETS" ] || { echo "w-devin: cannot read $SECRETS" >&2; exit 78; }
set -a; . "$SECRETS"; set +a

cd "$dir" || exit 1
out=$("$BIN" --model "$model" --respect-workspace-trust false \
        --permission-mode dangerous -p "$prompt" 2>&1); status=$?
printf '%s\n' "$out"
if printf '%s' "$out" | grep -q resource_exhausted; then
  echo "w-devin: account quota exhausted (retryable) — not an invocation fault" >&2
  exit 75
fi
exit "$status"
