#!/usr/bin/env bash
# Hourly wrapper around box-reap, for launchd.
#
# WHY THIS EXISTS
# ascii.dev has no idle timer. `--ttl` counts from creation or resume, never
# from last activity, so it kills a job mid-work and never stops an unused Box
# early. Nothing stops a Box for being idle. A forgotten `default` Box bills
# $0.036/h forever, and a `large` one is $52/month.
#
# The previous safety net, com.pooriaarab.crabbox-sweep, ran once a day at
# 09:00, defaulted to provider=gcp, did not scan ~/Documents/Personal, and was
# NOT LOADED in launchd at all. So in practice nothing was stopping boxes.
#
# This runs hourly and delegates the decision to box-reap, which never reaps on
# Box state -- a Box pegged at 100% CPU still reports `idle`. It measures CPU
# and load and honours the heartbeat and keep files.
set -uo pipefail

LOG="${BOX_REAP_LOG:-$HOME/.local/state/box-reap/reap.log}"
mkdir -p "$(dirname "$LOG")"

export PATH="$HOME/.ascii/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

# The API key is not in launchd's environment, and macOS TCC blocks a launchd
# agent from reading ~/Documents at all ("Operation not permitted", exit 126)
# unless you grant Full Disk Access by hand. So the credential and the reaper
# both live under ~/.config and ~/.local, which TCC does not gate.
for SECRETS in "$HOME/.config/ascii-box/env" "$HOME/Documents/Personal/.secrets/crabbox.env"; do
  if [[ -r "$SECRETS" ]]; then set -a; . "$SECRETS"; set +a; break; fi
done

REAP="${BOX_REAP_BIN:-$HOME/.local/bin/box-reap}"
[[ -x "$REAP" ]] || REAP="$HOME/Documents/Personal/scripts/box-reap"
[[ -x "$REAP" ]] || { echo "$(date -u +%FT%TZ) box-reap missing at $REAP" >> "$LOG"; exit 1; }

# 45m is deliberately generous: an attach-and-build cycle is minutes, so a Box
# quiet for 45 minutes with low CPU and no heartbeat is genuinely abandoned.
AGE="${BOX_REAP_AGE:-45m}"

# Capture the reaper's own status. Inside a `{ ... } >> log` block the status is
# thrown away and the trailing log-rotation `if` becomes the script's exit code,
# so a reaper that failed on a missing credential or an API error still exits 0
# and `launchctl list` shows a healthy job while nothing is being stopped.
# Bound anything unbounded FIRST. `box new --no-auto-stop` leaves
# `archiveAfter: null` and nothing will ever stop that Box -- five accumulated
# in one afternoon here, idle, on track for ~$155/month. box-guard only sets a
# deadline; it never stops a Box, so it cannot interrupt real work.
GUARD="${BOX_GUARD_BIN:-$HOME/.local/bin/box-guard}"
[[ -x "$GUARD" ]] || GUARD="$HOME/Documents/Personal/scripts/box-guard"
if [[ -x "$GUARD" ]]; then
  {
    echo "===== $(date -u +%FT%TZ) box-guard --apply"
    "$GUARD" --apply --ttl "${BOX_GUARD_TTL:-7200}" 2>&1
  } >> "$LOG" 2>&1
fi

echo "===== $(date -u +%FT%TZ) box-reap --stop-idle-older-than $AGE --execute" >> "$LOG"
"$REAP" --stop-idle-older-than "$AGE" --execute >> "$LOG" 2>&1
rc=$?
echo "----- exit=$rc" >> "$LOG"

# ORPHANS: a Box no session claims.
#
# box-session records the Box it warmed for a repo in ~/.local/state/box-work/<repo>.id.
# Any other running Box was started by a session that ended without stopping it, or by a
# bare `box new`. Nothing will ever claim it again, so it bills until its archive deadline.
# Measured here on 2026-08-30: 14 running Boxes, 2 claimed, 12 orphaned — enough burn for
# the credit check to project a $287 overrun in a 15-day window.
#
# Orphans get a shorter age than claimed Boxes, and nothing else changes: the same
# box-reap probe still runs, so a busy Box is still never stopped. The age is the only
# knob, because "unclaimed" is evidence about intent, not about activity.
ORPHAN_AGE="${BOX_REAP_ORPHAN_AGE:-15m}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/box-work"

# A claim file only means something while its session lives. A session killed before
# `box-session end` runs leaves the file behind, and a stale claim would shield its Box
# from the sweep forever. So a claim expires: past CLAIM_TTL the Box is treated as
# unclaimed, which is the safe direction — it still has to pass the activity probe.
CLAIM_TTL_MIN="${BOX_REAP_CLAIM_TTL_MIN:-360}"

claimed=""
stale_claims=""
for f in "$STATE_DIR"/*.id; do
  [[ -f "$f" ]] || continue
  id="$(tr -d '[:space:]' < "$f")"
  [[ -n "$id" ]] || continue
  if [[ -n "$(find "$f" -mmin "+$CLAIM_TTL_MIN" 2>/dev/null)" ]]; then
    stale_claims="$stale_claims $(basename "$f" .id):$id"
  else
    claimed="$claimed $id"
  fi
done

# SECOND CLAIM NAMESPACE. `crabbox-attach` (the git-worktree-add wrapper) also creates
# Boxes, and records them in the WORKTREE as `.crabbox-slug` — a slug, not a bx_ id, in a
# namespace `box-session` and `box-work` never read. Ignoring it cuts both ways: those
# Boxes look unclaimed here (so nothing ever stopped them), and a Box a live worktree is
# attached to could be swept while its session is merely thinking rather than building.
# So resolve slugs against the live Box list and treat a match as claimed. A slug with no
# match is a stale marker from a deleted Box and is ignored.
# A worktree claim ages out like a session claim does. Removing a worktree takes its
# .crabbox-slug with it, so that case reaps itself; the case this covers is a worktree that
# still exists but nobody has touched for hours, whose Box would otherwise be shielded
# forever.
worktree_slugs=""
stale_slugs=""
while read -r f; do
  [[ -f "$f" ]] || continue
  slug="$(tr -d '[:space:]' < "$f")"
  [[ -n "$slug" ]] || continue
  if [[ -n "$(find "$f" -mmin "+$CLAIM_TTL_MIN" 2>/dev/null)" ]]; then
    stale_slugs="$stale_slugs $slug"
  else
    worktree_slugs="$worktree_slugs $slug"
  fi
done < <(find "$HOME/Documents/Personal" -maxdepth 5 -name .crabbox-slug -print 2>/dev/null)

if [[ -n "$stale_slugs" ]]; then
  echo "$(date -u +%FT%TZ) worktree slug(s) untouched for ${CLAIM_TTL_MIN}m, no longer shielding:$stale_slugs" >> "$LOG"
fi

# Enumeration failure must not look like "no orphans". Capture the list, check the status,
# and fail loudly: a silent empty result would skip the sweep while the job still reported
# the first reaper's exit code, which is how a cost leak hides behind a green cron.
if ! box_json="$(box list --json 2>&1)"; then
  echo "$(date -u +%FT%TZ) ERROR: box list failed, skipping orphan sweep: ${box_json:0:200}" >> "$LOG"
  exit 4
fi
if ! orphan_ids="$(printf '%s' "$box_json" | WORKTREE_SLUGS="$worktree_slugs" python3 -c '
import sys, json, os
slugs = set(os.environ.get("WORKTREE_SLUGS", "").split())
d = json.load(sys.stdin)
for b in d["boxes"]:
    # A Box a live worktree points at is in use, whichever namespace recorded it.
    if b.get("subdomain") in slugs or b.get("name") in slugs:
        continue
    print(b["id"])
' 2>&1)"; then
  echo "$(date -u +%FT%TZ) ERROR: could not parse box list, skipping orphan sweep: ${orphan_ids:0:200}" >> "$LOG"
  exit 4
fi

orphan_args=()
while read -r id; do
  [[ -n "$id" ]] || continue
  case " $claimed " in *" $id "*) continue ;; esac
  orphan_args+=(--box "$id")
done <<< "$orphan_ids"

if [[ -n "$stale_claims" ]]; then
  echo "$(date -u +%FT%TZ) stale claim file(s) past ${CLAIM_TTL_MIN}m, treating as unclaimed:$stale_claims" >> "$LOG"
fi

if [[ ${#orphan_args[@]} -gt 0 ]]; then
  {
    echo "===== $(date -u +%FT%TZ) orphan sweep: $(( ${#orphan_args[@]} / 2 )) unclaimed Box(es), age $ORPHAN_AGE"
    echo "claimed:${claimed:- none}"
    "$REAP" --stop-idle-older-than "$ORPHAN_AGE" --execute "${orphan_args[@]}" 2>&1
    orphan_rc=$?
    echo "----- orphan exit=$orphan_rc"
  } >> "$LOG" 2>&1
  # Don't let a failed orphan sweep hide behind a successful initial reap: launchd
  # only sees this script's final exit code, and that is what a green cron means.
  [[ $rc -eq 0 ]] && rc=$orphan_rc
fi

# Keep the log from growing without bound.
if [[ -f "$LOG" ]] && [[ $(wc -l < "$LOG") -gt 5000 ]]; then
  tail -2000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

exit "$rc"
