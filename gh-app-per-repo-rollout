#!/usr/bin/env bash
# Print setup commands or check one saved App. Never create or install an App.
set +x
set -euo pipefail

# Match pooriaarab-sec-fleet repository permissions. Metadata read is implicit.
# Keep administration and organization permissions out of this template.
STANDARD_PERMS=(
  contents=write pull_requests=write issues=write workflows=write
  actions=read checks=read statuses=read
)

SHORT_RE='^[a-z0-9]+(-[a-z0-9]+)*$'

usage() {
  cat >&2 <<'EOF'
Usage:
  gh-app-per-repo-rollout plan <short>
  gh-app-per-repo-rollout verify <short> [--online]
  gh-app-per-repo-rollout batch-status <manifest.tsv>
  gh-app-per-repo-rollout batch-plan <manifest.tsv> [--limit N]
  gh-app-per-repo-rollout batch-verify <manifest.tsv> [--online] [--limit N]

Short names use lowercase letters, digits, and single hyphens (1-60 characters).
Manifest TSV columns: canonical_repo<TAB>short (header row optional).
Keep manifest files in a private repository; do not commit them to public repos.
EOF
  exit 2
}

validate_short() {
  local short=$1
  [[ ${#short} -le 60 && $short =~ $SHORT_RE ]]
}

folder_for_short() {
  printf 'pooriaarab-%s-fleet-app' "$1"
}

app_for_short() {
  printf 'pooriaarab-%s-fleet' "$1"
}

print_plan() {
  local short=$1 folder app
  folder=$(folder_for_short "$short")
  app=$(app_for_short "$short")
  printf '# short=%s\n' "$short"
  printf '# Run from the scripts checkout. These commands are printed only.\n'
  printf '# In GitHub, select ONLY the target private repository.\n'
  printf '# Stop if GitHub assigns another slug; use its saved APP_SLUG for install.\n'
  printf 'secrets_root="$HOME/Documents/Personal/.secrets"\n'
  printf 'test ! -e "$secrets_root/%s" && \\\n' "$folder"
  printf './gh-app create --name %s' "$app"
  printf ' --perm %s' "${STANDARD_PERMS[@]}"
  printf ' && \\\n'
  printf 'mv -n "$secrets_root/%s" "$secrets_root/%s"\n' "$app" "$folder"
  printf './gh-app install %s --owner pooriaarab\n' "$app"
  printf 'GH_TOKEN="$(./gh-app token %s)" gh api rate_limit --jq '\''.resources.core | {limit, remaining, reset}'\''\n' "$folder"
  printf './gh-app-per-repo-rollout verify %s\n' "$short"
}

run_verify() {
  local short=$1 online=${2:-}
  local folder script_dir
  folder=$(folder_for_short "$short")
  script_dir=$(cd "$(dirname "$0")" && pwd)
  python3 - "$HOME/Documents/Personal/.secrets/$folder" "$script_dir/gh-app" "$online" <<'PY'
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

folder, helper, online = Path(sys.argv[1]), sys.argv[2], sys.argv[3]

def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)

try:
    values = {}
    for line in (folder / 'app.env').read_text().splitlines():
        parts = shlex.split(line, comments=True)
        if not parts:
            continue
        if parts[0] == 'export':
            parts = parts[1:]
        if len(parts) != 1 or '=' not in parts[0]:
            raise ValueError()
        key, value = parts[0].split('=', 1)
        if key in values:
            raise ValueError()
        values[key] = value
    for key in ('APP_ID', 'APP_INSTALLATION_ID'):
        if not re.fullmatch(r'[1-9][0-9]*', values.get(key, '')):
            raise ValueError()
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]{0,99}', values.get('APP_SLUG', '')):
        raise ValueError()
    if not (folder / 'app.pem').is_file():
        raise ValueError()
except (OSError, ValueError):
    fail('Saved App configuration is missing or invalid. Check app.env IDs, slug, and app.pem.')
print('PASS: saved App configuration (values withheld).')
if not online:
    sys.exit(0)
try:
    token = subprocess.run([helper, 'token', folder.name], capture_output=True,
                           text=True, check=True, timeout=90).stdout.strip()
    if not re.fullmatch(r'[A-Za-z0-9_]+', token):
        raise ValueError()
    env = dict(os.environ, GH_TOKEN=token, GH_HOST='github.com')
    for key in ('GH_DEBUG', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN', 'GITHUB_ENTERPRISE_TOKEN'):
        env.pop(key, None)
    response = subprocess.run(['gh', 'api', 'rate_limit'], env=env, capture_output=True,
                              text=True, check=True, timeout=60)
    core = json.loads(response.stdout)['resources']['core']
    result = {key: core[key] for key in ('limit', 'remaining', 'reset')}
    if any(type(value) is not int or value < 0 for value in result.values()):
        raise ValueError()
except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
    fail('Online verification fails. Check App access and gh availability. Output withheld.')
print(json.dumps(result, sort_keys=True))
PY
}

read_manifest_shorts() {
  local manifest=$1
  [[ -f $manifest && -r $manifest ]] || {
    echo "Manifest not readable: $manifest" >&2
    exit 2
  }
  python3 - "$manifest" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
short_re = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
for number, raw in enumerate(path.read_text().splitlines(), start=1):
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    parts = line.split("\t")
    if len(parts) < 2:
        raise SystemExit(f"line {number}: need canonical_repo and short columns")
    repo, short = parts[0].strip(), parts[1].strip()
    if repo.lower() in ("canonical_repo", "repo") and short.lower() == "short":
        continue
    if not short_re.fullmatch(short) or len(short) > 60:
        raise SystemExit(f"line {number}: invalid short {short!r}")
    print(short)
PY
}

batch_status() {
  local manifest=$1 secrets_root=$HOME/Documents/Personal/.secrets
  local total=0 ready=0 missing=0 tmp
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' RETURN
  read_manifest_shorts "$manifest" >"$tmp"
  while IFS= read -r short; do
    total=$((total + 1))
    local folder
    folder=$(folder_for_short "$short")
    if [[ -f $secrets_root/$folder/app.env && -f $secrets_root/$folder/app.pem ]]; then
      ready=$((ready + 1))
      printf 'ready\t%s\n' "$short"
    else
      missing=$((missing + 1))
      printf 'missing\t%s\n' "$short"
    fi
  done <"$tmp"
  printf 'summary\ttotal=%s\tready=%s\tmissing=%s\n' "$total" "$ready" "$missing"
}

batch_plan() {
  local manifest=$1 limit=${2:-0} count=0 tmp
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' RETURN
  read_manifest_shorts "$manifest" >"$tmp"
  while IFS= read -r short; do
    local folder=$HOME/Documents/Personal/.secrets/$(folder_for_short "$short")
    if [[ -f $folder/app.env && -f $folder/app.pem ]]; then
      continue
    fi
    print_plan "$short"
    printf '\n'
    count=$((count + 1))
    if [[ $limit -gt 0 && $count -ge $limit ]]; then
      break
    fi
  done <"$tmp"
}

batch_verify() {
  local manifest=$1 online=${2:-} limit=${3:-0} count=0 failed=0 tmp
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' RETURN
  read_manifest_shorts "$manifest" >"$tmp"
  while IFS= read -r short; do
    local folder=$HOME/Documents/Personal/.secrets/$(folder_for_short "$short")
    if [[ ! -f $folder/app.env || ! -f $folder/app.pem ]]; then
      continue
    fi
    printf '=== verify %s ===\n' "$short"
    if [[ -n $online ]]; then
      run_verify "$short" --online || failed=1
    else
      run_verify "$short" || failed=1
    fi
    count=$((count + 1))
    if [[ $limit -gt 0 && $count -ge $limit ]]; then
      break
    fi
  done <"$tmp"
  return "$failed"
}

[[ $# -ge 1 ]] || usage
action=$1
shift

case "$action" in
  plan)
    [[ $# == 1 ]] || usage
    validate_short "$1" || usage
    print_plan "$1"
    ;;
  verify)
    [[ $# == 1 || ($# == 2 && ${2:-} == --online) ]] || usage
    validate_short "$1" || usage
    run_verify "$1" "${2:-}"
    ;;
  batch-status)
    [[ $# == 1 ]] || usage
    batch_status "$1"
    ;;
  batch-plan)
    [[ $# -ge 1 ]] || usage
    manifest=$1
    shift
    limit=0
    while [[ $# -gt 0 ]]; do
      [[ $1 == --limit && $# -ge 2 ]] || usage
      limit=$2
      shift 2
    done
    batch_plan "$manifest" "$limit"
    ;;
  batch-verify)
    [[ $# -ge 1 ]] || usage
    manifest=$1
    shift
    online=
    limit=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --online) online=--online; shift ;;
        --limit)
          [[ $# -ge 2 ]] || usage
          limit=$2
          shift 2
          ;;
        *) usage ;;
      esac
    done
    batch_verify "$manifest" "$online" "$limit"
    ;;
  *) usage ;;
esac
