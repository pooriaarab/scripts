#!/usr/bin/env bash
# Roll out tsc-rs 0.8. Requires authenticated gh, git, bun, and python3.
# Merge mode also requires the fleet premerge command on PATH.
set -euo pipefail
OWNER=pooriaarab
VERSION=0.8.0
DRY_RUN=0
MERGE=0
REPOS=()
ROOT="$(mktemp -d "${TMPDIR:-/tmp}/tsc-rs-rollout.XXXXXX")"
trap 'rm -rf "$ROOT"' EXIT
usage() {
  cat <<'HELP'
Usage: tsc-rs-fleet-rollout [--owner NAME] [--repo NAME] [--dry-run] [--merge-when-green]

--repo is repeatable. Without it, inspect all active, owned repositories.
Eligible repositories need Bun, a configured PR prefix, typecheck, and ci:local.
Dry runs clone and inspect repositories without remote changes.
Merge mode checks each PR once through premerge. Pending PRs remain open.
Run again to check existing rollout PRs. No review credit is invented.
HELP
}
while (( $# )); do
  case "$1" in
    --owner|--repo)
      [[ $# -ge 2 && "$2" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || { usage >&2; exit 2; }
      if [[ "$1" == --owner ]]; then OWNER="$2"; else REPOS+=("$2"); fi
      shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --merge-when-green) MERGE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
for tool in gh git bun python3; do
  command -v "$tool" >/dev/null || { echo "Missing command: $tool" >&2; exit 2; }
done
if (( MERGE && ! DRY_RUN )); then
  command -v premerge >/dev/null || { echo 'Merge mode requires premerge on PATH.' >&2; exit 2; }
fi
gh auth status >/dev/null 2>&1 || { echo 'Authenticate gh before rollout.' >&2; exit 2; }
if (( ${#REPOS[@]} == 0 )); then
  gh repo list "$OWNER" --limit 1000 --json name,isArchived,isFork \
    --jq '.[] | select(.isArchived == false and .isFork == false) | .name' > "$ROOT/repos"
else
  printf '%s\n' "${REPOS[@]}" > "$ROOT/repos"
fi

# shellcheck disable=SC2329 # Invoked through an exported worker function.
merge_pr() {
  local repo="$1" number="$2" sha gate
  sha="$(gh pr view "$number" -R "$repo" --json headRefOid --jq .headRefOid)"
  if premerge "$number" "$repo"; then
    gh pr merge "$number" -R "$repo" --squash --delete-branch --match-head-commit "$sha"
  else
    gate=$?
    [[ "$gate" == 1 ]] || return "$gate"
    echo "Pending merge gates: $repo PR #$number"
  fi
}

# shellcheck disable=SC2329 # Invoked in a separate Bash process below.
process_repo() (
  set -euo pipefail
  local name="$1" repo="$OWNER/$1" dir="$ROOT/$1" prefix branch issue existing body claim sha result claim_body
  echo "Inspecting $repo"
  gh repo clone "$repo" "$dir" -- --depth 1 --quiet
  cd "$dir"
  if git grep -l 'supportsheep/packages/support' -- 'package.json' '**/package.json' >/dev/null 2>&1; then
    [[ -d "$ROOT/supportsheep" ]] || gh repo clone "$OWNER/supportsheep" "$ROOT/supportsheep" -- --depth 1 --quiet
    # Bun file: links are relative to each repo root, not the rollout temp dir.
    [[ -e "$dir/supportsheep" ]] || ln -s "$ROOT/supportsheep" "$dir/supportsheep"
  fi
  [[ -f package.json && ( -f bun.lock || -f bun.lockb ) ]] || { echo 'Skip: no Bun root package.'; exit 0; }
  [[ -f .github/pr-standards.json ]] || { echo 'Skip: no PR prefix configuration.'; exit 0; }
  prefix="$(python3 -c 'import json; print(json.load(open(".github/pr-standards.json"))["prefix"])')"
  [[ "$prefix" =~ ^[a-z]{2,4}$ ]] || { echo 'Invalid PR prefix.' >&2; exit 1; }
  existing="$(gh pr list -R "$repo" --state open --json number,headRefName \
    --jq '.[] | select(.headRefName | endswith("-tsc-rs-0-8")) | .number')"
  if [[ -n "$existing" ]]; then
    [[ "$existing" =~ ^[0-9]+$ ]] || { echo 'Multiple rollout PRs need review.' >&2; exit 1; }
    echo "Existing PR: https://github.com/$repo/pull/$existing"
    if (( MERGE && ! DRY_RUN )); then merge_pr "$repo" "$existing"; fi
    exit 0
  fi
  # Replace the TypeScript CLI with tsc-rs in tracked package.json (scripts, wireit, etc.).
  if python3 - "$VERSION" <<'PY'
import json, pathlib, re, subprocess, sys
TSC = re.compile(r'(?<![\w/.-])(?:bunx\s+)?tsc(?=\s)')
def uses_compiler(text):
    return bool(TSC.search(text) or re.search(r'(?<![\w/.-])tsc-rs\b', text))
def swap_compiler(text):
    return TSC.sub('tsc-rs', text)
def rewrite_package(data):
    changed = False
    def walk(node):
        nonlocal changed
        if isinstance(node, dict):
            for key, value in node.items():
                if isinstance(value, str):
                    if TSC.search(value):
                        new = swap_compiler(value)
                        if new != value:
                            node[key] = new
                            changed = True
                else:
                    walk(value)
        elif isinstance(node, list):
            for item in node:
                walk(item)
    walk(data)
    return changed
root = json.loads(pathlib.Path('package.json').read_text())
if not all(root.get('scripts', {}).get(k) for k in ('typecheck', 'ci:local')):
    print('Skip: typecheck and ci:local are required.')
    sys.exit(10)
paths = subprocess.check_output(['git', 'ls-files', '-z', '--', 'package.json', '**/package.json']).decode().split('\0')
changes, supported = [], False
for name in filter(None, paths):
    path = pathlib.Path(name)
    data = json.loads(path.read_text())
    if uses_compiler(json.dumps(data)):
        supported = True
    if rewrite_package(data):
        changes.append((path, data))
if not supported:
    print('Skip: no supported tsc commands.')
    sys.exit(10)
if not changes and root.get('devDependencies', {}).get('tsc-rs') == sys.argv[1] and 'tsc-rs' in root.get('trustedDependencies', []):
    leftover = False
    for name in filter(None, paths):
        if TSC.search(pathlib.Path(name).read_text()):
            leftover = True
            break
    if not leftover:
        print('Skip: already configured.')
        sys.exit(10)
for path, data in changes:
    path.write_text(json.dumps(data, indent=2) + '\n')
root = json.loads(pathlib.Path('package.json').read_text())
trusted = root.setdefault('trustedDependencies', [])
if 'tsc-rs' not in trusted:
    trusted.append('tsc-rs')
pathlib.Path('package.json').write_text(json.dumps(root, indent=2) + '\n')
PY
  then
    :
  else
    result=$?
    [[ "$result" == 10 ]] && exit 0
    exit "$result"
  fi
  if (( DRY_RUN )); then echo "Dry run: adopt tsc-rs@$VERSION in $repo"; exit 0; fi
  issue="$(gh issue list -R "$repo" --state open --search 'in:title "Adopt tsc-rs 0.8 for typecheck"' \
    --json number,title --jq '.[] | select(.title == "Adopt tsc-rs 0.8 for typecheck") | .number')"
  if [[ -z "$issue" ]]; then
    issue="$(gh issue create -R "$repo" --title 'Adopt tsc-rs 0.8 for typecheck' \
      --body 'Use tsc-rs 0.8 for no-emit type checks. Verify local CI before push.')"
    issue="${issue##*/}"
  fi
  [[ "$issue" =~ ^[0-9]+$ ]] || { echo 'Cannot select one rollout issue.' >&2; exit 1; }
  branch="$prefix-$issue-tsc-rs-0-8"
  claim="$(gh api --paginate "repos/$repo/issues/$issue/comments" \
    --jq '.[] | select(.body | contains("<!-- fleet-claim:tsc-rs-rollout -->")) | .id')"
  claim_body="<!-- fleet-claim:tsc-rs-rollout -->
Harness: fleet rollout. Model: none (deterministic script).
Host: $(hostname). Start: $(date -u +%FT%TZ). State: active.
Goal: adopt tsc-rs $VERSION. Branch: $branch."
  if [[ -n "$claim" ]]; then
    [[ "$claim" =~ ^[0-9]+$ ]] || { echo 'Multiple fleet claims need review.' >&2; exit 1; }
    gh api -X PATCH "repos/$repo/issues/comments/$claim" -f body="$claim_body" >/dev/null
  else
    claim="$(gh api "repos/$repo/issues/$issue/comments" -f body="$claim_body" --jq .id)"
  fi
  trap 'gh api -X PATCH "repos/$repo/issues/comments/$claim" -f body="<!-- fleet-claim:tsc-rs-rollout --> Harness: fleet rollout. Model: none. State: released. Branch: $branch." >/dev/null || true' EXIT
  git checkout -b "$branch"
  bun add --dev --exact "tsc-rs@$VERSION"
  bun install --frozen-lockfile
  # Directory and similar repos run require-site.ts before typecheck/lint.
  if [[ -f scripts/require-site.ts ]] && grep -q '"site:use"' package.json; then
    bun run site:use _starter
  fi
  bun run typecheck 2>&1 | tee "$ROOT/$name-typecheck.log"
  # Lockfile-only rollouts would run ci:full in a shallow clone; typecheck is the rollout gate.
  if [[ -z "${FAIL_CI:-}" ]] && [[ "$(python3 - <<'PY'
import subprocess
def changed():
    for ref in ("origin/main", "HEAD"):
        try:
            out = subprocess.check_output(["git", "diff", "--name-only", ref], text=True, stderr=subprocess.DEVNULL)
            return [p for p in out.splitlines() if p]
        except subprocess.CalledProcessError:
            continue
    out = subprocess.check_output(["git", "diff", "--name-only"], text=True)
    return [p for p in out.splitlines() if p]
def toolchain(path):
    return path in ("package.json", "bun.lock", "bun.lockb") or path.endswith("/package.json")
paths = changed()
print("yes" if paths and all(toolchain(p) for p in paths) else "no")
PY
)" == yes ]]; then
    echo "Fleet: tsc-rs-only diff; skipping ci:local (typecheck passed)"
  else
    bun run ci:local 2>&1 | tee "$ROOT/$name-ci.log"
  fi
  git add -- package.json
  while IFS= read -r -d '' path; do
    case "$path" in package.json|*/package.json|bun.lock|bun.lockb) git add -- "$path" ;; esac
  done < <(git diff --name-only -z)
  [[ -z "$(git diff --name-only)" ]] || { echo 'CI changed other tracked files; inspect manually.' >&2; exit 1; }
  git diff --cached --quiet && { echo 'No changes.'; exit 0; }
  git commit -m "Adopt tsc-rs $VERSION for typecheck"
  git push -u origin "$branch"
  sha="$(git rev-parse HEAD)"
  body="$ROOT/$name-pr.md"
  cat > "$body" <<EOF
Closes #$issue

## What
Pin tsc-rs $VERSION for typecheck, emit, and project builds (scripts and wireit).
Trust its install script through Bun.

## Why
Evaluate the Rust checker through the existing typecheck and CI gates.

## How I verified
\`bun install --frozen-lockfile\` -> exit 0
\`bun run typecheck\` -> exit 0 at $sha
\`bun run ci:local\` -> exit 0 at $sha
Operator: not applicable - compiler change with no web deployment.

Assisted-by: tsc-rs-fleet-rollout:none

The rollout uses a deterministic script with no model session.
Independent review is required before merge.
EOF
  existing="$(gh pr create -R "$repo" --head "$branch" \
    --title "[$(printf '%s' "$prefix" | tr '[:lower:]' '[:upper:]')-$issue] Adopt tsc-rs for typecheck" --body-file "$body")"
  echo "PR: $existing"
  if (( MERGE )); then merge_pr "$repo" "${existing##*/}"; fi
)

failed=0
while IFS= read -r repo; do
  [[ -n "$repo" ]] || continue
  [[ "$repo" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || { failed=1; continue; }
  # Separate Bash preserves errexit inside the function despite the conditional.
  export OWNER VERSION ROOT DRY_RUN MERGE
  export -f process_repo merge_pr
  if bash -euo pipefail -c 'process_repo "$1"' bash "$repo"; then
    echo "Complete: $OWNER/$repo"
  else
    echo "Failed: $OWNER/$repo" >&2
    failed=1
  fi
done < "$ROOT/repos"
exit "$failed"
