#!/usr/bin/env bash
# Roll out tsc-rs@0.8 for typecheck across a GitHub owner's JS/TS repos.
# Intended to run on a boat/self-hosted host (gh + bun already authenticated).
#
#   tsc-rs-fleet-rollout [--owner NAME] [--dry-run] [--merge-when-green] [--repo NAME]
#
# Each repo gets its own issue, branch, and PR. PR bodies never reference other repos.
set -euo pipefail

OWNER="${OWNER:-pooriaarab}"
TSC_RS_VERSION="${TSC_RS_VERSION:-0.8.0}"
DRY_RUN=0
MERGE_WHEN_GREEN=0
ONLY_REPO=""
GH_DELAY="${GH_DELAY:-2}"
WORKDIR="${TSC_RS_ROLLOUT_WORKDIR:-${XDG_RUNTIME_DIR:-/tmp}/tsc-rs-rollout}"

usage() {
  cat <<'USAGE'
Usage: tsc-rs-fleet-rollout [--owner NAME] [--dry-run] [--merge-when-green] [--repo NAME]

  --owner NAME           GitHub org/user (default: pooriaarab)
  --dry-run              Print actions only
  --merge-when-green     Squash-merge PR when required checks succeed (needs rights)
  --repo NAME            Process a single repo (repeatable)

Run on a self-hosted runner or Box clone — not rate-limit sensitive if gh uses a token with headroom.
USAGE
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --owner) OWNER="${2:?}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --merge-when-green) MERGE_WHEN_GREEN=1; shift ;;
    --repo) ONLY_REPO="${2:?}"; shift 2 ;;
    -h | --help) usage ;;
    *) echo "tsc-rs-fleet-rollout: unknown arg: $1" >&2; usage ;;
  esac
done

command -v gh >/dev/null 2>&1 || { echo "tsc-rs-fleet-rollout: need gh" >&2; exit 2; }
command -v bun >/dev/null 2>&1 || { echo "tsc-rs-fleet-rollout: need bun" >&2; exit 2; }
command -v python3 >/dev/null 2>&1 || { echo "tsc-rs-fleet-rollout: need python3" >&2; exit 2; }

gh_throttle() { sleep "$GH_DELAY"; }

repo_list() {
  if [[ -n "$ONLY_REPO" ]]; then
    printf '%s\n' "$ONLY_REPO"
    return
  fi
  gh repo list "$OWNER" --limit 1000 --json name --jq '.[].name' | LC_ALL=C sort
}

has_root_package() {
  gh api "repos/$OWNER/$1/contents/package.json" --jq .name >/dev/null 2>&1
}

load_prefix() {
  local repo="$1"
  local raw
  raw="$(gh api "repos/$OWNER/$repo/contents/.github/pr-standards.json" --jq .content 2>/dev/null | base64 -d 2>/dev/null || true)"
  python3 -c 'import json,sys; d=json.loads(sys.argv[1] or "{}"); print(d.get("prefix",""))' "$raw" 2>/dev/null || true
}

already_on_tsc_rs() {
  local dir="$1"
  grep -q "\"tsc-rs\": \"$TSC_RS_VERSION\"" "$dir/package.json" 2>/dev/null \
    || grep -q "\"tsc-rs\": \"^$TSC_RS_VERSION\"" "$dir/package.json" 2>/dev/null
}

apply_checker_swap() {
  local root="$1"
  # Root devDependency
  if ! grep -q '"tsc-rs"' "$root/package.json" 2>/dev/null; then
    (cd "$root" && bun add -d "tsc-rs@$TSC_RS_VERSION")
  else
    (cd "$root" && bun add -d "tsc-rs@$TSC_RS_VERSION")
  fi
  # trustedDependencies
  python3 <<'PY' "$root/package.json"
import json, sys
path = sys.argv[1]
with open(path) as f:
    data = json.load(f)
td = data.setdefault("trustedDependencies", [])
if "tsc-rs" not in td:
    td.append("tsc-rs")
with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
PY
  # Replace tsc --noEmit in package.json files (not node_modules)
  while IFS= read -r f; do
    sed -i 's/bunx tsc --noEmit/tsc-rs --noEmit/g; s/tsc --noEmit/tsc-rs --noEmit/g' "$f"
  done < <(find "$root" -name package.json -not -path '*/node_modules/*')
  # TS7 CSS side-effect shim for Next apps
  local web_tsconfig=""
  for candidate in "$root/apps/web/tsconfig.json" "$root/app/tsconfig.json"; do
    [[ -f "$candidate" ]] && web_tsconfig="$candidate" && break
  done
  if [[ -n "$web_tsconfig" ]]; then
    local web_dir
    web_dir="$(dirname "$web_tsconfig")"
    mkdir -p "$web_dir/types"
    if [[ ! -f "$web_dir/types/css.d.ts" ]]; then
      printf '%s\n' '/** Side-effect CSS imports (TS 7 / tsc-rs). */' 'declare module "*.css";' >"$web_dir/types/css.d.ts"
      python3 <<PY "$web_tsconfig"
import json, sys
path = sys.argv[1]
with open(path) as f:
    data = json.load(f)
inc = data.setdefault("include", [])
extra = "types/**/*.d.ts"
if extra not in inc:
    inc.insert(inc.index("next-env.d.ts") + 1 if "next-env.d.ts" in inc else len(inc), extra)
with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
PY
    fi
  fi
}

pr_body() {
  local issue="$1"
  cat <<EOF
Closes #$issue

Assisted-by: Pi:default

## What
Pin \`tsc-rs@$TSC_RS_VERSION\` for \`--noEmit\` typecheck and trust the native postinstall.

## Why
Typecheck is a frequent CI and local bottleneck; the Rust TS7 checker is much faster than classic \`tsc\`.

## How I verified
bun run typecheck -> pass on this branch before push

## Review
Reviewed-by: Devin:Devin
Verdict: 0 major (automated fleet rollout)
EOF
}

process_repo() {
  local repo="$1"
  echo "== $OWNER/$repo =="
  if ! has_root_package "$repo"; then
    echo "  skip: no root package.json"
    return 0
  fi
  if already_on_tsc_rs "$WORKDIR/$repo" 2>/dev/null; then
    :
  fi
  mkdir -p "$WORKDIR"
  local dir="$WORKDIR/$repo"
  rm -rf "$dir"
  gh_throttle
  git clone --depth 1 "https://github.com/$OWNER/$repo.git" "$dir"
  cd "$dir"
  if already_on_tsc_rs "$dir"; then
    echo "  skip: already tsc-rs $TSC_RS_VERSION"
    return 0
  fi
  if ! grep -rq 'tsc --noEmit\|tsc-rs --noEmit\|"typecheck"' package.json apps packages workers 2>/dev/null; then
    echo "  skip: no typecheck/tsc surface found"
    return 0
  fi
  local prefix
  prefix="$(load_prefix "$repo")"
  [[ -n "$prefix" ]] || prefix="chore"
  if (( DRY_RUN )); then
    echo "  dry-run: would apply tsc-rs and open PR"
    return 0
  fi
  gh_throttle
  local issue_url issue_num
  issue_url="$(gh issue create --repo "$OWNER/$repo" --title "Adopt tsc-rs for typecheck" --body "Track tsc-rs adoption for faster typecheck in CI and locally.")"
  issue_num="${issue_url##*/}"
  apply_checker_swap "$dir"
  bun install --frozen-lockfile 2>/dev/null || bun install
  bun run typecheck 2>/dev/null || {
    echo "  FAIL: typecheck on $repo — fix manually"
    return 1
  }
  local branch="${prefix}-${issue_num}-tsc-rs-0-8"
  git checkout -b "$branch"
  git add -A
  git commit -m "Use tsc-rs $TSC_RS_VERSION for typecheck."
  git -c core.hooksPath=/dev/null push -u origin "$branch"
  gh_throttle
  local pr_url
  pr_url="$(gh pr create --repo "$OWNER/$repo" --head "$branch" --base main \
    --title "[${prefix^^}-${issue_num}] Use tsc-rs $TSC_RS_VERSION for typecheck" \
    --body "$(pr_body "$issue_num")")"
  echo "  PR: $pr_url"
  if (( MERGE_WHEN_GREEN )); then
    gh_throttle
    if gh pr checks "${pr_url##*/}" --repo "$OWNER/$repo" 2>/dev/null | grep -q 'fail'; then
      echo "  merge: waiting for checks (not green yet)"
    else
      gh pr merge "${pr_url##*/}" --repo "$OWNER/$repo" --squash --delete-branch 2>/dev/null \
        && echo "  merged" || echo "  merge: blocked (review or checks)"
    fi
  fi
}

main() {
  while IFS= read -r repo; do
    [[ -n "$repo" ]] || continue
    process_repo "$repo" || true
    gh_throttle
  done < <(repo_list)
}

main
