#!/usr/bin/env python3
"""Run one JIT runner at a time. Install with boat-pool; systemd restarts this loop."""
import json
import datetime
import os
import pathlib
import signal
import subprocess
import time
import urllib.error
import urllib.parse
import urllib.request


def request(path, body=None):
    req = urllib.request.Request(os.environ['BROKER_URL'].rstrip('/') + path,
        data=None if body is None else json.dumps(body).encode(),
        headers={'Authorization': 'Bearer ' + os.environ['POOL_TOKEN'],
                 'Content-Type': 'application/json',
                 # Cloudflare answers the default Python-urllib agent with 403 (error 1010).
                 'User-Agent': 'boat-runner-agent'})
    with urllib.request.urlopen(req, timeout=60) as response:
        return json.loads(response.read() or 'null')


def stop(process):
    try:
        os.killpg(process.pid, signal.SIGTERM)
        process.wait(timeout=15)
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        process.wait()
    except ProcessLookupError:
        pass


def cleanup_attempt(label, operation):
    """Cleanup is best effort: even an unexpected failure must not block leasing."""
    try:
        return operation()
    except Exception as error:
        print(f'Cleanup {label} failed: {type(error).__name__}; continuing', flush=True)


def cleanup_job(root, started, previous_tmp):
    # Stop containers first, so they cannot keep ports open or write more files.
    def containers():
        ids = subprocess.check_output(['docker', 'ps', '-aq'], text=True, timeout=30).split()
        for container in ids:
            def remove_container():
                details = json.loads(subprocess.check_output(
                    ['docker', 'inspect', container], text=True, timeout=30))[0]
                created = datetime.datetime.fromisoformat(
                    details['Created'].replace('Z', '+00:00')).timestamp()
                if created > started:
                    subprocess.run(['docker', 'rm', '-f', container], check=True,
                                   timeout=45, stdout=subprocess.DEVNULL)
            cleanup_attempt('container', remove_container)

    if started is not None:
        cleanup_attempt('containers', containers)

    def temporary_files():
        for entry in pathlib.Path('/tmp').iterdir():
            def remove_entry():
                # lstat never follows a job-created symlink into a warm cache.
                metadata = entry.lstat()
                if (entry.name not in previous_tmp and metadata.st_mtime > started
                        and metadata.st_uid in (0, os.getuid())):
                    subprocess.run(['sudo', '-n', 'rm', '-rf', '--one-file-system',
                                    '--', str(entry)], check=True, timeout=30)
            cleanup_attempt('temporary entry', remove_entry)

    # Old lease files or a failed snapshot must never trigger a broad /tmp wipe.
    if started is not None and previous_tmp is not None:
        cleanup_attempt('temporary files', temporary_files)

    def workspaces():
        work = root / '_work'
        if work.exists():
            for entry in work.iterdir():
                if not entry.name.startswith('_') and entry.name != '.cache':
                    cleanup_attempt('workspace', lambda: subprocess.run(
                        ['sudo', '-n', 'rm', '-rf', '--', str(entry)], check=True, timeout=30))
    cleanup_attempt('workspaces', workspaces)
    print('Lease cleanup attempted; caches retained', flush=True)


def main():
    for key in ('BROKER_URL', 'POOL_TOKEN', 'POOL_LABEL', 'BOX_ID'):
        if not os.environ.get(key):
            raise SystemExit('Missing ' + key)
    root = pathlib.Path(os.environ.get('RUNNER_DIR', '/home/user/actions-runner'))
    os.chdir(root)
    current, busy = root / '.boat-lease.json', root / '.boat-busy'
    hook = root / 'boat-job-started.sh'
    hook.write_text('#!/bin/sh\ntouch "$(dirname "$0")/.boat-busy"\n')
    hook.chmod(0o700)
    last_prune = root / '.boat-pruned'
    while True:
        try:
            # A previous service incarnation may have died before reporting done.
            if current.exists():
                state = json.loads(current.read_text())
                lease = state.get('lease', state)  # Accept pre-upgrade lease files.
                request('/done', lease)
                cleanup_attempt('job', lambda: cleanup_job(
                    root, state.get('started'), state.get('previous_tmp')))
                current.unlink()
            if not last_prune.exists() or time.time() - last_prune.stat().st_mtime > 86400:
                result = subprocess.run(['docker', 'image', 'prune', '-f'], stdout=subprocess.DEVNULL)
                if result.returncode == 0:
                    last_prune.touch()
                else:
                    print('Docker prune failed; retrying later', flush=True)
            query = urllib.parse.urlencode({'label': os.environ['POOL_LABEL'], 'box': os.environ['BOX_ID']})
            lease = request('/lease?' + query)
            if not lease:
                continue
            previous_tmp = cleanup_attempt('snapshot', lambda: [
                entry.name for entry in pathlib.Path('/tmp').iterdir()])
            started = time.time()
            temporary = current.with_suffix('.tmp')
            with os.fdopen(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), 'w') as file:
                json.dump({'lease': lease, 'started': started,
                           'previous_tmp': previous_tmp}, file)
                file.flush()
                os.fsync(file.fileno())
            temporary.replace(current)
            busy.unlink(missing_ok=True)
            environment = {key: value for key, value in os.environ.items()
                           if key not in ('POOL_TOKEN', 'WEBHOOK_SECRET', 'GITHUB_TOKEN')}
            environment['ACTIONS_RUNNER_HOOK_JOB_STARTED'] = str(hook)
            with (root / 'boat-runner.log').open('w') as log:
                process = subprocess.Popen(['./run.sh', '--jitconfig', lease['encoded_jit_config']],
                    env=environment, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
                print(f"Started runner {lease['runner_id']} for job {lease['job_id']}", flush=True)
                deadline = time.monotonic() + 180
                try:
                    while process.poll() is None:
                        if not busy.exists() and time.monotonic() >= deadline:
                            print('Runner idle for 180 seconds; stopping', flush=True)
                            break
                        time.sleep(1)
                finally:
                    stop(process)
                print(f'Runner exited {process.returncode}; reporting done', flush=True)
        except (OSError, ValueError, urllib.error.URLError, subprocess.SubprocessError) as error:
            # Do not print upstream bodies, lease configs, URLs or credentials.
            print(f'Agent operation failed: {type(error).__name__}; retry in 5 seconds', flush=True)
            time.sleep(5)


if __name__ == '__main__':
    main()
