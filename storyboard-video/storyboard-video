#!/usr/bin/env python3
"""storyboard-video: turn one board.json into stills, a review board, Veo clips and an edited film.

Usage:
  storyboard-video check <dir>                       Validate <dir>/board.json against video.schema.json
  storyboard-video stills <dir> [ids...]             Cast sheet, then one still per shot anchored on it
  storyboard-video board <dir> <out.html>            Review board: cast, story, stills (or clips) per shot
  storyboard-video veo <dir> --confirm-spend [ids]   Image-to-video for each still (bills at submit)
  storyboard-video cut <dir>                         Edit clips into out/film.mp4 with camera, transitions, ducked VO
  storyboard-video verify <dir>                      Measure out/film.mp4 and write out/verify.json

Environment: VERTEX_PROJECT (required for stills, veo and voice-over). SV_IMAGE_MODEL,
SV_VIDEO_MODEL, SV_VIDEO_LOCATION and SV_TTS_MODEL override the board's `models`. gcloud supplies
the token, so CLOUDSDK_CONFIG picks the account. Exit status: 0 ok, 1 failed check, 2 bad usage.
"""
import base64, concurrent.futures as cf, datetime, html, json, os, re, subprocess, sys, time, urllib.error, urllib.parse, urllib.request

HERE = os.path.dirname(os.path.realpath(__file__))
DEFAULT_MODELS = {"image": "gemini-3-pro-image", "video": "veo-3.1-fast-generate-001", "tts": "gemini-3.1-flash-tts-preview"}
VIDEO_LOCATION = os.environ.get("SV_VIDEO_LOCATION", "us-central1")
# Rough USD per second of 720p video with audio. Third-party figures; check the Vertex AI price page.
VEO_RATE = {"lite": 0.05, "fast": 0.12, "": 0.40}
CLIP_SECONDS, W, H, FPS = 8, 1280, 720, 24


def die(msg, code=1):
    print(f"storyboard-video: {msg}", file=sys.stderr)
    sys.exit(code)


def validate(value, schema, root, path="board"):
    """The JSON Schema subset video.schema.json uses; returns a list of 'path: problem' strings."""
    if "$ref" in schema:
        schema = root["$defs"][schema["$ref"].rsplit("/", 1)[1]]
    kinds = {"object": dict, "array": list, "string": str, "boolean": bool, "integer": int, "number": (int, float)}
    want = schema.get("type")
    if want and (not isinstance(value, kinds[want]) or (want in ("integer", "number") and isinstance(value, bool))):
        return [f"{path}: expected {want}"]
    errs = []
    if "enum" in schema and value not in schema["enum"]:
        errs.append(f"{path}: {value!r} is not one of {schema['enum']}")
    if isinstance(value, str) and len(value) < schema.get("minLength", 0):
        errs.append(f"{path}: is empty")
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        if value < schema.get("minimum", value):
            errs.append(f"{path}: below {schema['minimum']}")
        if value > schema.get("maximum", value):
            errs.append(f"{path}: above {schema['maximum']}")
    if isinstance(value, list):
        if not schema.get("minItems", 0) <= len(value) <= schema.get("maxItems", len(value)):
            errs.append(f"{path}: has {len(value)} items")
        for i, item in enumerate(value):
            errs += validate(item, schema.get("items", {}), root, f"{path}[{i}]")
    if isinstance(value, dict):
        props = schema.get("properties", {})
        errs += [f"{path}.{k}: required" for k in schema.get("required", []) if k not in value]
        if schema.get("additionalProperties") is False:
            errs += [f"{path}.{k}: unknown field" for k in value if k not in props]
        for k, v in value.items():
            if k in props:
                errs += validate(v, props[k], root, f"{path}.{k}")
    return errs


def schema():
    return json.load(open(os.path.join(HERE, "video.schema.json")))


def load(d):
    try:
        b = json.load(open(os.path.join(d, "board.json")))
    except (OSError, ValueError) as e:
        die(f"cannot read board.json: {e}")
    errs = validate(b, schema(), schema())
    if errs:  # report the schema paths before anything below can trip on a malformed shape
        die("board.json does not match video.schema.json:\n  " + "\n  ".join(errs[:20]))
    ids = [s["id"] for s in b["shots"]]
    errs += [f"board.shots[{i}].edit.window: duration must be above 0" for i, s in enumerate(b["shots"]) if s["edit"]["window"][1] <= 0]
    errs += [f"board.shots: duplicate shot id {i}" for i in sorted({i for i in ids if ids.count(i) > 1}, key=str)]
    if errs:
        die("board.json does not match video.schema.json:\n  " + "\n  ".join(errs[:20]))
    return b


def model(b, kind):
    return os.environ.get(f"SV_{kind.upper()}_MODEL") or b.get("models", {}).get(kind) or DEFAULT_MODELS[kind]


def theme(b):
    t = b["theme"]
    extra = " ".join(f"{k.capitalize()}: {', '.join(t[k]) if isinstance(t[k], list) else t[k]}." for k in ("palette", "lighting", "lens", "motion") if t.get(k))
    return f"{t['style']} {extra}".strip() + (f" Never show: {t['negative']}." if t.get("negative") else "")


def cast(b):
    return " ".join(f"{c['name']}: {c['anchor']}." for c in b["cast"])


def save(path, data):
    """Write only after the data exists, so a failed call never leaves an empty or truncated file."""
    with open(path, "wb") as f:
        f.write(data)


def name(sid, ext):
    return f"shot-{int(sid):02d}.{ext}"


def project():
    p = os.environ.get("VERTEX_PROJECT")
    if not p:
        die("set VERTEX_PROJECT to the Google Cloud project that has Vertex AI enabled")
    return p


def call(url, body):
    tok = subprocess.check_output(["gcloud", "auth", "print-access-token"], text=True).strip()
    req = urllib.request.Request(url, json.dumps(body).encode(), {
        "Authorization": f"Bearer {tok}", "x-goog-user-project": project(), "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=300) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"HTTP {e.code}: {e.read().decode()[:400]}")


def gemini(model_id, parts, config):
    url = f"https://aiplatform.googleapis.com/v1/projects/{project()}/locations/global/publishers/google/models/{model_id}:generateContent"
    data = call(url, {"contents": [{"role": "user", "parts": parts}], "generationConfig": config})
    for p in data["candidates"][0]["content"]["parts"]:
        if "inlineData" in p:
            return base64.b64decode(p["inlineData"]["data"])
    raise RuntimeError(f"no media in response: {json.dumps(data)[:300]}")


def parallel(fn, items):
    with cf.ThreadPoolExecutor(5) as ex:
        results = list(ex.map(fn, items))
    for r in results:
        print(r, flush=True)
    if any("FAILED" in r for r in results):
        sys.exit(1)


def pick(b, ids):
    want = {int(i) for i in ids}
    return [s for s in b["shots"] if not want or s["id"] in want]


def cmd_stills(d, ids):
    b, img = load(d), os.path.join(d, "img")
    project()
    os.makedirs(img, exist_ok=True)
    cfg = {"responseModalities": ["IMAGE"], "imageConfig": {"aspectRatio": "16:9"}}
    cast_path = os.path.join(img, "cast.png")
    if not os.path.exists(cast_path):
        prompt = (f"Character reference sheet on a plain background, every character full body, front view, side by side, "
                  f"name label under each. Style: {theme(b)} Characters: {cast(b)}")
        save(cast_path, gemini(model(b, "image"), [{"text": prompt}], cfg))
        print("cast ok", flush=True)
    sheet = {"inlineData": {"mimeType": "image/png", "data": base64.b64encode(open(cast_path, "rb").read()).decode()}}

    def one(s):
        # The scene leads and is repeated after the identity lock: with the sheet attached, a model
        # sometimes returns the sheet itself unless told plainly to draw one scene.
        scene = s["prompts"]["still"]
        prompt = (f"Storyboard frame {s['id']} of a short launch film. Draw ONE cinematic scene, never a character lineup. "
                  f"Scene: {scene} Use the EXACT characters from the reference sheet (same faces, hair, outfits, colours); "
                  f"do not draw the sheet or name labels. Scene again: {scene} Style: {theme(b)} 16:9 film still, no captions.")
        try:
            save(os.path.join(img, name(s["id"], "png")), gemini(model(b, "image"), [sheet, {"text": prompt}], cfg))
            return f"shot {s['id']} ok"
        except Exception as e:
            return f"shot {s['id']} FAILED: {e}"

    parallel(one, pick(b, ids))


def cmd_veo(d, args):
    b = load(d)
    video = model(b, "video")
    shots = pick(b, [a for a in args if a != "--confirm-spend"])
    tier = next((t for t in ("lite", "fast") if t in video), "")
    cost = len(shots) * CLIP_SECONDS * VEO_RATE[tier]
    if "--confirm-spend" not in args:
        die(f"{len(shots)} clips x {CLIP_SECONDS}s on {video} is about {cost:.2f} USD, billed at submit even if you "
            f"stop polling. Review the stills first, then re-run with --confirm-spend.")
    budget = b.get("budget", {})
    if not any(x["stage"] == "stills" for x in budget.get("approvals", [])):
        die("budget.approvals has no 'stills' entry. Show the stills, record the yes, then run veo.")
    spent = sum(x["usd"] for x in budget.get("spend", []))
    if "capUsd" in budget and round(spent + cost, 2) > budget["capUsd"]:  # round so an exact match is not a float overshoot
        die(f"estimate {cost:.2f} + recorded spend {spent:.2f} USD would pass budget.capUsd {budget['capUsd']}")
    base = (f"https://{VIDEO_LOCATION}-aiplatform.googleapis.com/v1/projects/{project()}/locations/{VIDEO_LOCATION}"
            f"/publishers/google/models/{video}")
    os.makedirs(os.path.join(d, "vid"), exist_ok=True)

    def one(s):
        still = os.path.join(d, "img", name(s["id"], "png"))
        prompt = (f"Animate this exact frame; keep every character, prop and set identical. Action: {s['prompts'].get('motion', s.get('action', ''))} "
                  f"Style: {theme(b)} Audio: foley and sound effects plus any quoted line spoken in the scene; no narration, no music.")
        try:
            op = call(f"{base}:predictLongRunning", {
                "instances": [{"prompt": prompt, "image": {"bytesBase64Encoded": base64.b64encode(open(still, "rb").read()).decode(), "mimeType": "image/png"}}],
                "parameters": {"aspectRatio": "16:9", "durationSeconds": CLIP_SECONDS, "generateAudio": True, "sampleCount": 1, "resolution": "720p"}})
            for _ in range(80):
                time.sleep(15)
                res = call(f"{base}:fetchPredictOperation", {"operationName": op["name"]})
                if res.get("done"):
                    vids = res.get("response", {}).get("videos") or []
                    if not vids:
                        return f"shot {s['id']} FAILED: {json.dumps(res)[:300]}"
                    save(os.path.join(d, "vid", name(s["id"], "mp4")), base64.b64decode(vids[0]["bytesBase64Encoded"]))
                    return f"shot {s['id']} ok"
            return f"shot {s['id']} FAILED: timeout, operation {op['name']}"
        except Exception as e:
            return f"shot {s['id']} FAILED: {e}"

    parallel(one, shots)


def cmd_board(d, out):
    b, e = load(d), html.escape
    rel = os.path.relpath(d, os.path.dirname(os.path.abspath(out)))  # media paths work wherever the board is saved
    cards = []
    for s in b["shots"]:
        img, vid = f"img/{name(s['id'], 'png')}", f"vid/{name(s['id'], 'mp4')}"
        exists, img, vid = os.path.exists(os.path.join(d, vid)), *(e(urllib.parse.quote(os.path.join(rel, p))) for p in (img, vid))
        media = (f'<video src="{vid}" poster="{img}" controls preload="none"></video>' if exists
                 else f'<img src="{img}" alt="Frame {s["id"]}">')
        vo = f'<p class="vo">VO: {e(s["vo"])}</p>' if s.get("vo") else ""
        cards.append(f'<div class="shot">{media}<div class="b"><span class="st">{e(s.get("stage", ""))}</span>'
                     f'<h3>{s["id"]} · {e(s["title"])}</h3><p>{e(s.get("action", ""))}</p>{vo}</div></div>')
    doc = (f'<!doctype html><meta charset="utf-8"><title>{e(b["meta"]["title"])}</title><style>'
           "body{font:14px system-ui;background:#111;color:#eee;margin:24px}.g{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px}"
           ".shot{background:#1b1b1f;border:1px solid #333;border-radius:10px;overflow:hidden}.shot img,.shot video{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}"
           ".b{padding:10px}.st{font:700 10px monospace;background:#f2c14e;color:#111;padding:2px 6px;border-radius:4px}h3{margin:6px 0}.vo{color:#aaa;font-style:italic}"
           f'.cast{{max-width:640px;width:100%;border-radius:10px}}</style><h1>{e(b["meta"]["title"])}</h1>'
           f'<img class="cast" src="{e(urllib.parse.quote(os.path.join(rel, "img/cast.png")))}" alt="Cast sheet"><p>{e(b.get("story", {}).get("arc", cast(b)))}</p><div class="g">{"".join(cards)}</div>')
    open(out, "w").write(doc)
    print(out)


def seconds(path):
    return float(subprocess.check_output(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", path], text=True))


def voice(b, sid, line, work):
    wav = os.path.join(work, name(sid, "wav").replace("shot", "vo"))
    vo = b.get("audio", {}).get("voiceOver", {})
    key, key_path = f"{model(b, 'tts')}|{vo.get('voice', 'Charon')}|{vo.get('direction', '')}|{line}", wav + ".key"
    # A wav with no key file is a hand-recorded line: keep it. A generated one is redone when its text or voice changes.
    if os.path.exists(wav) and (not os.path.exists(key_path) or open(key_path).read() == key):
        return wav
    pcm = gemini(model(b, "tts"), [{"text": f"Say as a {vo.get('direction', 'warm narrator, brisk pace')}: {line}"}], {
        "responseModalities": ["AUDIO"],
        "speechConfig": {"voiceConfig": {"prebuiltVoiceConfig": {"voiceName": vo.get("voice", "Charon")}}}})
    save(wav + ".pcm", pcm)
    trim = "silenceremove=start_periods=1:start_threshold=-45dB,areverse"
    subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-f", "s16le", "-ar", "24000", "-ac", "1", "-i", wav + ".pcm",
                    "-af", f"{trim},{trim}", wav], check=True)
    open(key_path, "w").write(key)
    return wav


def cmd_cut(d):
    b = load(d)
    shots, work = b["shots"], os.path.join(d, "out", "work")
    os.makedirs(work, exist_ok=True)
    mix = b.get("audio", {}).get("mix", {})
    duck = {"threshold": 0.02, "ratio": 10, "attackMs": 15, "releaseMs": 350, **mix.get("duck", {})}
    fade = mix.get("cutFadeMs", 80) / 1000
    max_speed = b.get("audio", {}).get("voiceOver", {}).get("maxSpeed", 1.2)
    inputs, chains = [], []

    def add(*args):
        inputs.extend(args)
        return inputs.count("-i") - 1

    for n, s in enumerate(shots):
        ed = s["edit"]
        start, dur = ed["window"]
        f = min(fade, dur / 2)  # a fade longer than half the shot would start before it
        clip = add("-i", os.path.join(d, "vid", name(s["id"], "mp4")))
        z = ed.get("zoom", "1")
        if ed.get("useStill"):  # the video model drifted: keep the clip's sound, show the approved still
            k = add("-loop", "1", "-framerate", str(FPS), "-t", str(dur), "-i", os.path.join(d, "img", name(s["id"], "png")))
            src = f"[{k}:v]scale={W}:{H}:force_original_aspect_ratio=increase,crop={W}:{H},"
        else:
            src = f"[{clip}:v]trim=start={start}:duration={dur},"
        chains.append(f"{src}setpts=PTS-STARTPTS,fps={FPS},scale=w='trunc({W}*({z})/2)*2':h=-2:eval=frame,"
                      f"crop={W}:{H},setsar=1,format=yuv420p,settb=1/{FPS * 1000}[v{n}]")
        chains.append(f"[{clip}:a]atrim=start={start}:duration={dur},asetpts=PTS-STARTPTS,aresample=48000,"
                      f"volume={ed.get('sceneVolume', mix.get('sceneVolume', 0.7))},afade=t=in:d={f * 0.75},afade=t=out:st={dur - f}:d={f}[a{n}]")

    vlab, alab, length, starts = "v0", "a0", shots[0]["edit"]["window"][1], [0.0]
    for n, s in enumerate(shots[1:], 1):
        dur, tr = s["edit"]["window"][1], s["edit"].get("transition")
        if tr:
            td = tr["seconds"]
            starts.append(length - td)
            chains.append(f"[{vlab}][v{n}]xfade=transition={tr['type']}:duration={td}:offset={length - td}[vj{n}]")
            chains.append(f"[{alab}][a{n}]acrossfade=d={td}[aj{n}]")
            length += dur - td
        else:
            starts.append(length)
            chains.append(f"[{vlab}][{alab}][v{n}][a{n}]concat=n=2:v=1:a=1[vc{n}][aj{n}]")
            chains.append(f"[vc{n}]settb=1/{FPS * 1000}[vj{n}]")
            length += dur
        vlab, alab = f"vj{n}", f"aj{n}"

    # Lines queue: each starts at its shot or after the previous line, and speeds up (up to maxSpeed)
    # only to finish before the next shot; anything still too long is reported, never overlapped.
    vo, prev_end = [], 0.0
    for n, s in enumerate(shots):
        if not s.get("vo"):
            continue
        wav = voice(b, s["id"], s["vo"], work)
        begin = max(starts[n] + 0.12, prev_end + 0.12)
        deadline = starts[n + 1] + 0.25 if n + 1 < len(shots) else length - 0.35
        raw = seconds(wav)
        speed = max(1.0, min(max_speed, raw / max(deadline - begin, 0.1)))
        prev_end = begin + raw / speed
        if prev_end > deadline + 0.05:
            print(f"warning: shot {s['id']} line runs {prev_end - deadline:.2f}s past its slot; shorten it or lengthen the shot", file=sys.stderr)
        k = add("-i", wav)
        chains.append(f"[{k}:a]atempo={speed:.3f},aresample=48000,pan=stereo|c0=c0|c1=c0,adelay={int(begin * 1000)}:all=1[vo{len(vo)}]")
        vo.append(f"[vo{len(vo)}]")

    if vo:  # the narrator keys a sidechain that ducks the scene sound while they talk
        chains.append(f"{''.join(vo)}amix=inputs={len(vo)}:normalize=0,apad=whole_dur={length},asplit=2[vomix][vokey]")
        chains.append(f"[{alab}][vokey]sidechaincompress=threshold={duck['threshold']}:ratio={duck['ratio']}:"
                      f"attack={duck['attackMs']}:release={duck['releaseMs']}[bed]")
        chains.append("[bed][vomix]amix=inputs=2:weights='1 1.15':normalize=0[mix]")
    else:
        chains.append(f"[{alab}]anull[mix]")
    chains.append(f"[mix]afade=t=out:st={length - 0.5}:d=0.5,loudnorm=I={mix.get('targetLufs', -16)}:TP={mix.get('truePeak', -1.5)},aresample=48000[aout]")

    out = os.path.join(d, "out", "film.mp4")
    # No -avoid_negative_ts: it shifts video by the AAC priming delay (0.021 s) and players show a black first frame.
    r = subprocess.run(["ffmpeg", "-y", *inputs, "-filter_complex", ";".join(chains), "-map", f"[{vlab}]", "-map", "[aout]",
                        "-c:v", "libx264", "-crf", "18", "-c:a", "aac", "-b:a", "192k", "-ar", "48000", "-movflags", "+faststart", out],
                       capture_output=True, text=True)
    if r.returncode:
        die(r.stderr[-1500:])
    json.dump({"length_s": round(length, 3), "shot_starts_s": {str(s["id"]): round(t, 3) for s, t in zip(shots, starts)}},
              open(os.path.join(d, "out", "timeline.json"), "w"), indent=1)
    print(json.dumps({"film": out, "length_s": round(seconds(out), 2)}))


def cmd_verify(d):
    b = load(d)
    film, timeline = os.path.join(d, "out", "film.mp4"), json.load(open(os.path.join(d, "out", "timeline.json")))
    mix = b.get("audio", {}).get("mix", {})
    starts = subprocess.check_output(["ffprobe", "-v", "error", "-show_entries", "stream=codec_type,start_time", "-of", "csv=p=0", film], text=True).split()
    eb = subprocess.run(["ffmpeg", "-i", film, "-map", "0:a:0", "-af", "ebur128=peak=true", "-f", "null", "-"], capture_output=True, text=True)
    found = re.findall(r"I:\s+(-?[\d.]+) LUFS", eb.stderr)
    lufs = float(found[-1]) if eb.returncode == 0 and found else None  # no audio stream, or ffmpeg failed: the check fails
    bd = subprocess.run(["ffmpeg", "-i", film, "-map", "0:v:0", "-vf", "blackdetect=d=0.04:pix_th=0.08", "-f", "null", "-"], capture_output=True, text=True)
    black = re.findall(r"black_start:([\d.]+)", bd.stderr) if bd.returncode == 0 else None  # a failed scan must not pass
    length, target = seconds(film), mix.get("targetLufs", -16)
    checks = [
        {"name": "streams start at 0", "method": "ffprobe stream start_time", "expected": "0.000000 for every stream",
         "actual": " ".join(starts), "pass": all(x.split(",")[-1] == "0.000000" for x in starts)},
        {"name": "length matches timeline", "method": "ffprobe duration vs out/timeline.json", "expected": f"{timeline['length_s']} ± 0.15 s",
         "actual": f"{length:.3f} s", "pass": abs(length - timeline["length_s"]) <= 0.15},
        {"name": "loudness", "method": "ffmpeg ebur128 integrated", "expected": f"{target} ± 1.5 LUFS",
         "actual": f"{lufs} LUFS" if lufs is not None else "not measured: " + eb.stderr.strip().splitlines()[-1][:120],
         "pass": lufs is not None and abs(lufs - target) <= 1.5},
        {"name": "no black opening frame", "method": "ffmpeg blackdetect", "expected": "no black segment at 0 s",
         "actual": "scan failed" if black is None else ", ".join(black) or "none",
         "pass": black is not None and not any(float(t) < 1 / 48 for t in black)},  # only a black frame at 0 s fails
    ]
    record = {"checkedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"), "film": "out/film.mp4", "checks": checks}
    errs = validate(record, {"$ref": "#/$defs/verify"}, schema(), "verify")
    if errs:
        die("verify record does not match the schema: " + "; ".join(errs))
    json.dump(record, open(os.path.join(d, "out", "verify.json"), "w"), indent=1)
    failed = [c["name"] for c in checks if not c["pass"]]
    print(json.dumps({"verify": "out/verify.json", "failed": failed}))
    if failed:
        die("failed checks: " + ", ".join(failed))


def main():
    a = sys.argv[1:]
    if len(a) < 2:
        die(__doc__.strip(), 2)
    cmd, d, rest = a[0], a[1], a[2:]
    if cmd == "check":
        b = load(d)
        print(json.dumps({"title": b["meta"]["title"], "shots": len(b["shots"])}))
    elif cmd == "stills":
        cmd_stills(d, rest)
    elif cmd == "veo":
        cmd_veo(d, rest)
    elif cmd == "board" and len(rest) == 1:
        cmd_board(d, rest[0])
    elif cmd == "cut":
        cmd_cut(d)
    elif cmd == "verify":
        cmd_verify(d)
    else:
        die(__doc__.strip(), 2)


if __name__ == "__main__":
    main()
