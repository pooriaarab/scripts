#!/usr/bin/env bash
# t3-box-provision — spin up a standing Box running T3 Code as a persistent
# systemd user service, reachable over a public box-host URL. One command.
#
# Captures every gotcha learned the hard way (2026-09-03):
#  - Use a HYDRATED snapshot (--from agent-roster-ready): toolchain + CLIs preloaded.
#  - --no-auto-stop: a T3 server Box must stay up (exclude from reaper; ~$13-26/mo).
#  - loginctl enable-linger: WITHOUT it `systemctl --user` has no D-Bus.
#  - Over `box exec` you MUST export XDG_RUNTIME_DIR=/run/user/<uid> (and
#    DBUS_SESSION_BUS_ADDRESS) or systemctl --user says "Failed to connect to bus".
#  - box exec `bash -lc "…$var…"` MANGLES multi-step strings -> run a scp'd script.
#  - box host --public carries HTTP + PAIRING, but NOT T3's live WebSocket: the
#    ascii/Caddy edge answers a WS upgrade with 200 HTML, never 101, so the client
#    pairs then fails "could not establish a WebSocket". To actually connect the
#    GUI, reach T3 over an SSH TUNNEL: on the laptop run
#      box ssh -L 3773:localhost:3773 <box>
#    and add the environment as http://localhost:3773 (WS runs over raw TCP).
#  - systemctl --user (not a detached process): survives ssh disconnect + resume.
#  - T3 logs its FULL ENV (injected CLAUDE_CODE_OAUTH_TOKEN/OPENAI_API_KEY/…) at
#    boot -> NEVER dump journalctl wholesale; grep only the pairingUrl line.
#
# USAGE:  t3-box-provision            # new standing Box + T3 + public URL + pair code
#         t3-box-provision --reuse bx_x
set -uo pipefail
export PATH="$HOME/.ascii/bin:$PATH"
REUSE=""
if [[ "${1:-}" == "--reuse" ]]; then
  REUSE="${2:-}"
  [[ -n "$REUSE" ]] || { echo "usage: t3-box-provision --reuse bx_x (missing box id)" >&2; exit 1; }
  shift 2
elif [[ $# -gt 0 ]]; then
  echo "usage: t3-box-provision [--reuse bx_x] (unrecognized argument: $1)" >&2
  exit 1
fi
[[ $# -eq 0 ]] || { echo "usage: t3-box-provision --reuse bx_x (unexpected extra argument: $1)" >&2; exit 1; }

if [[ -n "$REUSE" ]]; then BOX="$REUSE"; echo "reusing $BOX"; else
  echo "== creating standing Box =="
  BOX="$(box new --type default --no-auto-stop --from agent-roster-ready --environment agent-roster --json 2>/dev/null | sed -n 's/.*"id":"\(bx_[a-z0-9]*\)".*/\1/p' | head -1)"
  [[ -n "$BOX" ]] || { echo "could not create Box" >&2; exit 1; }
  echo "BOX=$BOX"
fi
READY=""
for _ in $(seq 1 40); do box exec "$BOX" --timeout 20 -- true >/dev/null 2>&1 && { READY=1; break; }; sleep 2; done
[[ -n "$READY" ]] || { echo "could not reach $BOX via box exec — aborting" >&2; exit 1; }

# never-reap + enable linger (idempotent)
box exec "$BOX" -- touch /home/user/.box-reap-keep >/dev/null 2>&1 || true
box exec "$BOX" -- loginctl enable-linger user >/dev/null 2>&1 || { echo "could not enable linger on $BOX — t3code would not survive session end, aborting" >&2; exit 1; }

# on-box setup script (a FILE, to dodge box-exec arg mangling)
TMP="$(mktemp)"; cat > "$TMP" <<'ONBOX'
#!/usr/bin/env bash
set -uo pipefail
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
# install T3's own service unit (creates ~/.t3 runtime + launcher)
npx --yes t3@latest service install >/dev/null 2>&1 || true
# force host/port via a drop-in
DROP="$HOME/.config/systemd/user/t3code.service.d"; mkdir -p "$DROP"
printf '[Service]\nEnvironment=T3CODE_HOST=0.0.0.0\nEnvironment=T3CODE_PORT=3773\nEnvironment=PATH=%%h/.local/bin:/usr/local/bin:/usr/bin:/bin\n' > "$DROP/override.conf"
pkill -f "t3@latest" 2>/dev/null; sleep 1        # free 3773 from any foreground run
systemctl --user daemon-reload
systemctl --user enable t3code || { echo "could not enable t3code — it would not survive a reboot" >&2; exit 1; }
systemctl --user restart t3code   # restart (not just enable --now) so a reused box picks up the drop-in
for _ in $(seq 1 15); do systemctl --user is-active --quiet t3code && ss -ltn 2>/dev/null | grep -q '0.0.0.0:3773' && break; sleep 2; done
systemctl --user is-active --quiet t3code && ss -ltn 2>/dev/null | grep -q '0.0.0.0:3773' && echo T3_LISTENING || echo T3_NOT_LISTENING
# print ONLY the pairing token line (never the env dump)
journalctl --user -u t3code -o cat -n 200 2>/dev/null | grep -aoE '/pair#token=[A-Za-z0-9]+' | tail -1
ONBOX
box scp "$TMP" "$BOX:/home/user/t3-onbox-setup.sh" >/dev/null 2>&1 || { echo "could not copy setup script to $BOX" >&2; rm -f "$TMP"; exit 1; }
RES="$(box exec "$BOX" --json --timeout 300 -- bash /home/user/t3-onbox-setup.sh 2>/dev/null | jq -r '.stdout')"
rm -f "$TMP"
if ! echo "$RES" | grep -q T3_LISTENING; then
  echo "!! T3 not listening — check 'box ssh $BOX' journalctl --user -u t3code" >&2
  exit 1
fi
echo "== T3 listening on 0.0.0.0:3773 =="
PAIR="$(printf '%s' "$RES" | grep -oE '/pair#token=[A-Za-z0-9]+' | tail -1)"

# public URL (MUST be --public)
HOST_OUT="$(box host "$BOX" 3773 --public 2>/dev/null)"
[[ -n "$HOST_OUT" ]] || { echo "could not get public URL for $BOX — box host failed" >&2; exit 1; }
URL="$(printf '%s' "$HOST_OUT" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')"
[[ -z "$URL" ]] && URL="$HOST_OUT"

echo
echo "================ T3 BOX READY ================"
echo "Box:          $BOX   (standing, --no-auto-stop)"
echo "Public URL:   $URL"
[[ -n "$PAIR" ]] && echo "Pair URL:     ${URL}${PAIR}" || echo "Pair code:    (reuses ~/.t3 auth; if prompted, box ssh $BOX -> journalctl --user -u t3code -o cat | grep pairingUrl)"
echo "NOTE: the GUI WebSocket does NOT connect through this public URL (the edge"
echo "      drops the WS upgrade). To connect the T3 client, tunnel instead:"
echo "        box ssh -L 3773:localhost:3773 $BOX"
echo "      then Add Environment -> Remote link -> Host=http://localhost:3773 + code."
echo "Stop when done:  box stop $BOX   (it bills while up)"
echo "============================================="
