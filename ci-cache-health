    where = ", ".join(row["where"][:2])
    if len(row["where"]) > 2:
        where += f" (+{len(row['where']) - 2})"
    primary = str(row["primary_hits"]) if row["keyed_restores"] else "?"
    print(f"{name:<34} {row['restores']:>5} {row['hits']:>5} {primary:>7} "
