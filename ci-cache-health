head = f"{'KEY PREFIX':<34} {'READS':>5} {'HITS':>5} {'PRIMARY':>7} {'MISS':>5} {'SAVES':>5} {'MEDIAN':>9}  WHERE"
print(head)
print("-" * len(head))
if not cache_rows:
