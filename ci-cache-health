print(head)
print("-" * len(head))
if not turbo_rows:
    print("(no turbo invocations seen)")
for row in turbo_rows:
    name = row["command"]
    if len(name) > 34:
        name = name[:31] + "..."
    if row["remote_cache_off"] and row["remote_cache_on"]:
        remote = f"{row['remote_cache_on']}/{row['invocations']} on"
    elif row["remote_cache_off"]:
