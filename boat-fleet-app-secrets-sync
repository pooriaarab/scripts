#!/usr/bin/env bash
# Copy per-repo fleet GitHub App key folders from the Mac to fleet Boat boxes.
#
# Syncs every ~/Documents/Personal/.secrets/pooriaarab-*-fleet-app/ directory
# (wave 1: directory, yaya, imecore) onto each box listed in boxes.txt.
# Does not print pem or token contents.
#
# Usage:
#   boat-fleet-app-secrets-sync              # all boxes in ~/.sec-fleet/boxes.txt
#   boat-fleet-app-secrets-sync --check      # list folders and boxes only
#   boat-fleet-app-secrets-sync bx_abc123    # one box id
#
# Requires: box CLI (~/.ascii/bin/box), crabbox.env for API auth (same as tokloop).
set -euo pipefail

SECRETS_ROOT="${SECRETS_ROOT:-$HOME/Documents/Personal/.secrets}"
BOXES_FILE="${BOAT_BOXES_FILE:-$HOME/.sec-fleet/boxes.txt}"
BOX="${BOX:-$HOME/.ascii/bin/box}"

die() { echo "boat-fleet-app-secrets-sync: $*" >&2; exit 1; }

command -v "$BOX" >/dev/null || die "missing box CLI at $BOX"
[[ -d "$SECRETS_ROOT" ]] || die "missing secrets root: $SECRETS_ROOT"

mapfile -t APP_DIRS < <(
  find "$SECRETS_ROOT" -maxdepth 1 -type d -name 'pooriaarab-*-fleet-app' \
    ! -name 'pooriaarab-sec-fleet-app' \
    | sort
)
(( ${#APP_DIRS[@]} > 0 )) || die "no pooriaarab-*-fleet-app folders under $SECRETS_ROOT"

for d in "${APP_DIRS[@]}"; do
  for f in app.env app.pem; do
    [[ -f "$d/$f" ]] || die "incomplete folder (missing $f): $d"
  done
done

CHECK=0
RESUME=0
TARGETS=()
for arg in "$@"; do
  case "$arg" in
    --check) CHECK=1 ;;
    --resume) RESUME=1 ;;
    -h|--help)
      sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) TARGETS+=("$arg") ;;
  esac
done

if (( ${#TARGETS[@]} == 0 )); then
  [[ -r "$BOXES_FILE" ]] || die "missing boxes file: $BOXES_FILE"
  mapfile -t TARGETS < "$BOXES_FILE"
fi

(( ${#TARGETS[@]} > 0 )) || die "no target boxes"

echo "folders (${#APP_DIRS[@]}):"
for d in "${APP_DIRS[@]}"; do echo "  $(basename "$d")"; done
echo "boxes (${#TARGETS[@]}):"
for b in "${TARGETS[@]}"; do echo "  $b"; done

(( CHECK )) && exit 0

if (( RESUME )) && command -v boat >/dev/null 2>&1; then
  for b in "${TARGETS[@]}"; do
    [[ -n "$b" ]] || continue
    boat resume "$b" >/dev/null 2>&1 || true
  done
fi

if [[ -r "$HOME/Documents/Personal/.secrets/crabbox.env" ]]; then
  set -a
  # shellcheck source=/dev/null
  . "$HOME/Documents/Personal/.secrets/crabbox.env"
  set +a
fi

export PATH="$HOME/.ascii/bin:${PATH:-}"

# Tar each folder and extract on the box under the same secrets root layout.
push_box() {
  local box_id=$1
  local ok=0 fail=0
  for d in "${APP_DIRS[@]}"; do
    local name
    name=$(basename "$d")
    if tar czf - -C "$SECRETS_ROOT" "$name" 2>/dev/null | "$BOX" ssh "$box_id" "bash -s" <<'REMOTE'
set -euo pipefail
root="${HOME}/Documents/Personal/.secrets"
mkdir -p "$root"
tar xzf - -C "$root"
chmod 700 "$root" 2>/dev/null || true
for dir in "$root"/pooriaarab-*-fleet-app; do
  [ -d "$dir" ] || continue
  chmod 700 "$dir"
  chmod 600 "$dir"/app.env "$dir"/app.pem "$dir"/app-pkcs8.pem 2>/dev/null || true
  chmod 600 "$dir"/conversion.json 2>/dev/null || true
done
REMOTE
    then
      ok=$((ok + 1))
    else
      fail=$((fail + 1))
      echo "fail $box_id $name" >&2
    fi
  done
  echo "$box_id ok=$ok fail=$fail"
}

failed=0
for b in "${TARGETS[@]}"; do
  [[ -n "$b" ]] || continue
  line=$(push_box "$b") || { echo "fail $b (ssh)" >&2; failed=1; continue; }
  echo "$line"
  [[ "$line" == *' fail=0'* ]] || failed=1
done

exit "$failed"
