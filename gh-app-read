#!/usr/bin/env bash
# Run read-only gh commands on a GitHub App installation token, so agent reads
# do not drain the owner token. Each App has its own hourly budget, often
# 12,500 requests. The wrapper rotates across the Apps you list.
# Use it for reads only. Writes and merges use plain gh with the owner token.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: gh-app-read <gh arguments>

Run a read-only gh command with an installation token from a rotating list of
GitHub Apps. A token is cached for 50 minutes in a file with mode 600.

Environment:
  GH_READ_APPS        Required. Space-separated App names, for example "app-a app-b".
  GH_APP_TOKEN_CMD    Required. Command that prints one token. {app} becomes the
                      App name. Example: 'my-token-tool token {app}'
  GH_READ_CACHE_DIR   Token cache folder. Default: $TMPDIR, else /tmp.
  GH_READ_TTL_MIN     Minutes a cached token lives. Default: 50.
  GH_BIN              The gh program to run. Default: gh.

Allowed:
  api <path>          GET only. Flags that send data or set another method fail.
  pr|issue            view, list, diff, checks, status
  run|release|repo    view, list
  search, status
Any other command exits 2. Use plain gh for it.

Examples:
  gh-app-read api rate_limit --jq .rate
  gh-app-read pr view 12 -R <owner>/<repo> --json state,headRefOid
USAGE
}

case "${1:-}" in -h|--help|help|"") usage; [ -n "${1:-}" ] && exit 0 || exit 2 ;; esac

die() { echo "gh-app-read: $*" >&2; exit "${2:-1}"; }

[ -n "${GH_READ_APPS:-}" ] || die "GH_READ_APPS is empty. Run with --help." 2
[ -n "${GH_APP_TOKEN_CMD:-}" ] || die "GH_APP_TOKEN_CMD is empty. Run with --help." 2

allowed() {
  local a=("$@") i
  case "${a[0]}" in
    search|status) return 0 ;;
    pr|issue) case "${a[1]:-}" in view|list|diff|checks|status) return 0 ;; esac ;;
    run|release|repo) case "${a[1]:-}" in view|list) return 0 ;; esac ;;
    api)
      for ((i = 1; i < ${#a[@]}; i++)); do
        case "${a[i]}" in
          -X|--method) [ "$(printf '%s' "${a[i+1]:-}" | tr a-z A-Z)" = GET ] || return 1 ;;
          -X*|--method=*) return 1 ;;
          -f|-F|--field|--raw-field|--input|-f?*|-F?*|--field=*|--raw-field=*|--input=*) return 1 ;;
        esac
      done
      return 0 ;;
  esac
  return 1
}

allowed "$@" || die "refusing a command that may write: gh $1 ${2:-}. Use plain gh." 2

read -r -a apps <<<"$GH_READ_APPS"
app="${apps[$(( $$ % ${#apps[@]} ))]}"
[[ "$app" =~ ^[A-Za-z0-9._-]+$ ]] || die "App name has unsafe characters: $app" 2

dir="${GH_READ_CACHE_DIR:-${TMPDIR:-/tmp}}"
cache="$dir/gh-app-read-token-$(id -u)-$app"
ttl="${GH_READ_TTL_MIN:-50}"

if [ ! -s "$cache" ] || [ -n "$(find "$cache" -mmin "+$ttl" 2>/dev/null)" ]; then
  umask 077
  cmd="${GH_APP_TOKEN_CMD//\{app\}/$app}"
  bash -c "$cmd" > "$cache.tmp" || { rm -f "$cache.tmp"; die "token command failed for $app"; }
  [ -s "$cache.tmp" ] || { rm -f "$cache.tmp"; die "token command printed nothing for $app"; }
  chmod 600 "$cache.tmp"
  mv "$cache.tmp" "$cache"
fi

GH_TOKEN="$(tr -d '\n' < "$cache")" exec "${GH_BIN:-gh}" "$@"
