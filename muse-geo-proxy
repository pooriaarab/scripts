#!/usr/bin/env python3
"""muse-geo-proxy: an allow-listed HTTPS CONNECT proxy for Muse on a Box.

Meta serves the Muse model list per region. A Box in France sees an empty list
for the same key that lists every model from Canada, so `muse exec` fails with
"model ... does not exist or you lack access". This proxy sends only Muse's own
hosts out of the machine it runs on (the laptop, in Canada).

It binds to 127.0.0.1 and refuses every host that is not on the allow list, so
a Box cannot use the home address for anything else.

Usage:
  muse-geo-proxy serve [PORT]            run the proxy (default 18899)
  muse-geo-proxy box <box-id> [PORT]     serve, tunnel the port into the Box,
                                         and keep both up until Ctrl-C

On the Box, run Muse with the proxy only for Muse:
  HTTPS_PROXY=http://127.0.0.1:18899 muse exec --trust-workspace "<brief>"
"""
import asyncio
import os
import signal
import subprocess
import sys

PORT = 18899
ALLOW = ("api.meta.ai", "auth.meta.com", "lookaside.facebook.com")


async def pipe(reader, writer):
    try:
        while data := await reader.read(65536):
            writer.write(data)
            await writer.drain()
    except (ConnectionError, asyncio.CancelledError):
        pass
    finally:
        writer.close()


async def handle(client_r, client_w):
    try:
        request = await asyncio.wait_for(client_r.readuntil(b"\r\n\r\n"), 10)
        method, target, _ = request.split(b"\r\n", 1)[0].decode().split(" ", 2)
        host, _, port = target.partition(":")
        if method != "CONNECT" or host not in ALLOW or (port or "443") != "443":
            client_w.write(b"HTTP/1.1 403 Forbidden\r\n\r\n")
            await client_w.drain()
            print(f"deny {method} {target}", flush=True)
            return
        up_r, up_w = await asyncio.wait_for(asyncio.open_connection(host, 443), 10)
        client_w.write(b"HTTP/1.1 200 Connection Established\r\n\r\n")
        await client_w.drain()
        await asyncio.gather(pipe(client_r, up_w), pipe(up_r, client_w))
    except Exception as err:  # a bad client must not stop the proxy
        print(f"error {err!r}", flush=True)
    finally:
        client_w.close()


async def serve(port):
    server = await asyncio.start_server(handle, "127.0.0.1", port)
    print(f"muse-geo-proxy on 127.0.0.1:{port}, allow {', '.join(ALLOW)}", flush=True)
    async with server:
        await server.serve_forever()


def main():
    args = sys.argv[1:]
    if not args or args[0] not in ("serve", "box"):
        sys.exit(__doc__)
    if args[0] == "serve":
        asyncio.run(serve(int(args[1]) if len(args) > 1 else PORT))
        return
    if len(args) < 2:
        sys.exit("muse-geo-proxy box <box-id> [PORT]")
    box_id, port = args[1], int(args[2]) if len(args) > 2 else PORT
    box = os.path.expanduser("~/.ascii/bin/box")
    me = subprocess.Popen([sys.executable, __file__, "serve", str(port)])
    tunnel = subprocess.Popen(
        [box, "forward", box_id, "--reverse", "--local", str(port), "--remote", str(port)]
    )
    signal.signal(signal.SIGTERM, lambda *_: (me.kill(), tunnel.kill(), sys.exit(0)))
    try:
        tunnel.wait()
    except KeyboardInterrupt:
        pass
    finally:
        me.kill()
        tunnel.kill()


if __name__ == "__main__":
    main()
