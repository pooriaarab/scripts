#!/usr/bin/env bash
# Sync the domain-email-warming toolkit scripts from the skill checkout to
# the live share, or report drift without changing anything.
#
# WHY THIS EXISTS
# The warm-up toolkit runs from ~/.local/share/domain-email-warming but is
# developed in the skills repo. Hand copies drift: the live tree grows files
# the repo lacks (or the reverse) and nobody notices until a run behaves
# differently from the code under review. This tool makes the sync explicit
# and the drift visible.
#
#   warm-domain-sync [--check] [--src DIR] [--dst DIR]
#
# Copies scripts/*.mjs, *.py, *.sh and scripts/lib/*.mjs from SRC to DST.
# Never touches config/, state/, vendor/, or anything else in DST, and never
# deletes: live-only files are reported, not removed. --check exits 2 on any
# drift, 0 when in sync.
#
# Env overrides: WARM_DOMAIN_SRC, WARM_DOMAIN_HOME.
set -uo pipefail

CHECK=0
SRC="${WARM_DOMAIN_SRC:-$HOME/Documents/Personal/skills/domain-email-warming}"
DST="${WARM_DOMAIN_HOME:-$HOME/.local/share/domain-email-warming}"

while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK=1; shift;;
    --src) SRC="${2:?--src needs a directory}"; shift 2;;
    --dst) DST="${2:?--dst needs a directory}"; shift 2;;
    -h|--help) sed -n '2,/^set /p' "$0" | sed 's/^# \?//'; exit 0;;
    *) echo "warm-domain-sync: unknown argument: $1" >&2; exit 64;;
  esac
done

[ -f "$SRC/scripts/warmctl.mjs" ] || { echo "warm-domain-sync: no toolkit at $SRC (scripts/warmctl.mjs missing)" >&2; exit 127; }

# Refuse to sync a tree onto itself (means SRC/DST resolve the same).
if [ -d "$DST/scripts" ] && [ "$SRC/scripts" -ef "$DST/scripts" ]; then
  echo "warm-domain-sync: src and dst are the same directory" >&2; exit 64
fi

shopt -s nullglob
SRC_FILES=( "$SRC"/scripts/*.mjs "$SRC"/scripts/*.py "$SRC"/scripts/*.sh "$SRC"/scripts/lib/*.mjs )
[ "${#SRC_FILES[@]}" -gt 0 ] || { echo "warm-domain-sync: no script files under $SRC/scripts" >&2; exit 127; }

drift=0
synced=0
failed=0
for f in "${SRC_FILES[@]}"; do
  rel="${f#$SRC/}"
  if [ ! -f "$DST/$rel" ]; then
    echo "missing: $rel"
    drift=1
    if [ "$CHECK" -eq 0 ]; then
      if mkdir -p "$DST/$(dirname "$rel")" && cp -p "$f" "$DST/$rel"; then synced=$((synced+1)); else echo "failed: $rel" >&2; failed=1; fi
    fi
  elif ! cmp -s "$f" "$DST/$rel"; then
    echo "differs: $rel"
    drift=1
    if [ "$CHECK" -eq 0 ]; then
      if cp -p "$f" "$DST/$rel"; then synced=$((synced+1)); else echo "failed: $rel" >&2; failed=1; fi
    fi
  fi
done

# Live-only scripts are drift too: every live script should come from the repo.
if [ -d "$DST/scripts" ]; then
  while IFS= read -r lf; do
    rel="${lf#$DST/}"
    case "$rel" in
      scripts/lib/*) [ -f "$SRC/$rel" ] || { echo "live-only: $rel"; drift=1; };;
      scripts/*) case "$rel" in *.mjs|*.py|*.sh) [ -f "$SRC/$rel" ] || { echo "live-only: $rel"; drift=1; };; esac;;
    esac
  done < <(find "$DST/scripts" -type f)
fi

if [ "$CHECK" -eq 1 ]; then
  if [ "$drift" -eq 0 ]; then echo "in sync: ${#SRC_FILES[@]} files"; exit 0; fi
  exit 2
fi
if [ "$failed" -eq 1 ]; then echo "warm-domain-sync: $synced synced, some copies failed" >&2; exit 1; fi
echo "$synced synced, $((${#SRC_FILES[@]}-synced)) unchanged"
