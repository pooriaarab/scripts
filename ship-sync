#!/usr/bin/env bash
# ship-sync - open a promotion PR from main, or build a sync branch.
#
# Usage:
#   ship-sync --repo OWNER/NAME --prefix P --assisted-by AGENT:MODEL
#             (--issue N | --open) [--main main] [--prod release]
#             [--slug ship-sync] [--labels a,b] [--body-out FILE]
#
# When production has no commits that main lacks, use main as the PR head.
# This fast-forward path creates no local branch and pushes nothing.
# When production has unique commits, build <prefix>-<issue>-<slug> from
# main with production as a second parent (`git merge -s ours`).
# The branch tree equals main. The tool prints its path and commit counts.
#
# A diverged release over 500 counted lines still fails the PR size cap.
# No label clears this cap. The oversized-approved label no longer exists.
# Only a head equal to the repo's default branch gets the promotion exemption.
#
# Without --open, write the PR body to --body-out or stdout. Build a local
# branch only when production has unique commits.
# With --open, also create an issue unless --issue supplies one, push only
# a diverged sync branch, and open the PR into production. Calls use REST.
# It never merges. A person reviews the PR and merges it.
#
# The tool refuses a slug that contains "release", because fleet pre-push
# hooks block any branch name with that word.
# --assisted-by is required; the tool cannot know the agent and model.
#
# Credentials: the `gh` CLI login, used only with --open.
# Needs: git, node; gh with --open.
set -euo pipefail

die() { echo "ship-sync: $*" >&2; exit 1; }

repo="" prefix="" assisted="" issue="" open=0 main="main" prod="release"
slug="ship-sync" labels="" bodyout=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) repo="$2"; shift 2 ;;
    --prefix) prefix="$2"; shift 2 ;;
    --assisted-by) assisted="$2"; shift 2 ;;
    --issue) issue="$2"; shift 2 ;;
    --open) open=1; shift ;;
    --main) main="$2"; shift 2 ;;
    --prod) prod="$2"; shift 2 ;;
    --slug) slug="$2"; shift 2 ;;
    --labels) labels="$2"; shift 2 ;;
    --body-out) bodyout="$2"; shift 2 ;;
    -h|--help) sed -n '2,/^set -euo pipefail/{ /^set -euo pipefail/!p; }' "$0"; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done
[ -n "$repo" ] && [ -n "$prefix" ] && [ -n "$assisted" ] \
  || die "need --repo, --prefix and --assisted-by (see --help)"
[[ "$prefix" =~ ^[a-z]{2,4}$ ]] || die "--prefix must be 2-4 lowercase letters"
[[ "$assisted" == *:* ]] || die "--assisted-by must be AGENT:MODEL"
[ -n "$issue" ] || [ "$open" = 1 ] || die "give --issue N, or --open to create the issue"
[ -z "$issue" ] || [[ "$issue" =~ ^[0-9]+$ ]] || die "--issue must be a number"
shopt -s nocasematch
[[ "$slug" == *release* ]] && die "slug '$slug' contains 'release'; pre-push hooks refuse that branch name"
shopt -u nocasematch

[ -z "$(git status --porcelain --untracked-files=no)" ] || die "checkout has uncommitted changes"
git fetch -q origin
git rev-parse -q --verify "origin/$main^{commit}" >/dev/null || die "no origin/$main"
git rev-parse -q --verify "origin/$prod^{commit}" >/dev/null \
  || die "no origin/$prod; create the production branch first"
if [ -z "$(git diff "origin/$prod" "origin/$main")" ]; then
  echo "ship-sync: origin/$prod already has the tree of origin/$main; nothing to ship"
  exit 0
fi

read -r behind ahead < <(git rev-list --left-right --count "origin/$main...origin/$prod")
[ -n "$behind" ] && [ -n "$ahead" ] || die "cannot compare branches"
# pr-standards exempts a head branch from the name rule only when it is called `main`,
# so a default branch with another name (trunk, production) takes the ours-merge path.
ff=0
[ "$ahead" -eq 0 ] && [ "$main" = main ] && ff=1
if [ "$ff" -eq 1 ]; then
  echo "ship-sync: fast-forward path: $prod behind $behind, ahead $ahead; use head $main without a push" >&2
  merge_rc=0
  git merge-tree --write-tree "origin/$prod" "origin/$main" >/dev/null || merge_rc=$?
  [ "$merge_rc" -eq 0 ] || die "merge-tree exited $merge_rc; nothing pushed; no alternate path"
else
  if [ "$ahead" -eq 0 ]; then
    echo "ship-sync: ours-merge path: $prod behind $behind, ahead $ahead, default branch $main is not named main; use an ours-merge branch" >&2
  else
    echo "ship-sync: diverged path: $prod behind $behind, ahead $ahead; use an ours-merge branch" >&2
  fi
fi

name="${repo#*/}"; version=""
if git cat-file -e "origin/$main:package.json" 2>/dev/null; then
  read -r name version < <(git show "origin/$main:package.json" \
    | node -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>{const p=JSON.parse(s);console.log(p.name||"", p.version||"")})')
fi
what="${name}${version:+ $version}"
subject="Ship ${version:-$main} to $prod"

if [ -z "$issue" ]; then
  args=()
  for l in ${labels//,/ }; do args+=(-f "labels[]=$l"); done
  ibody=$(printf '## Job to be done\nPeople get the changes on %s from the production branch.\n\n## Today and wanted\n%s has merged changes that %s lacks. Wanted: ship %s to %s.\n\n## Acceptance criteria\n- [ ] The %s tree equals %s.\n- [ ] The production workflow ships %s.\n\n## How to verify\n`git diff origin/%s origin/%s` prints nothing after the merge.\n' \
    "$main" "$main" "$prod" "$main" "$prod" "$prod" "$main" "$what" "$main" "$prod")
  issue=$(gh api "repos/$repo/issues" -f "title=$subject" -f "body=$ibody" ${args[@]+"${args[@]}"} --jq .number) \
    || die "issue creation failed; nothing pushed"
fi

if [ "$ff" -eq 1 ]; then
  b="$main"
  sha=$(git rev-parse "origin/$main")
  details="$prod has no commits that $main lacks. The PR uses $main directly as its head, so it follows main until it merges. The merge gate pins the checked commit with --match-head-commit."
  evidence=$(printf '`git rev-list --left-right --count origin/%s...origin/%s` -> behind %s, ahead %s\n`git merge-tree --write-tree origin/%s origin/%s` -> exit %s' \
    "$main" "$prod" "$behind" "$ahead" "$prod" "$main" "$merge_rc")
else
  b="$prefix-$issue-$slug"
  git checkout -q -B "$b" "origin/$main"
  git merge -q -s ours --no-edit "origin/$prod" -m "Sync the $prod branch with $main"
  [ -z "$(git diff "origin/$main" "$b")" ] || die "tree of $b differs from origin/$main; nothing pushed"
  git merge-base --is-ancestor "origin/$prod" "$b" || die "origin/$prod is not a parent of $b"
  sha=$(git rev-parse "$b")
  details="This branch has the exact tree of $main, with $prod recorded as a parent by an ours-merge."
  evidence=$(printf '`git diff origin/%s %s` -> no changes (empty diff)\n`git merge-base --is-ancestor origin/%s %s` -> exit 0, %s is a parent' \
    "$main" "$b" "$prod" "$b" "$prod")
fi

body=$(cat <<EOF
Closes #$issue

## What
Ships $main to the $prod branch, so the production workflow ships $what.

## Why
$main has merged changes that $prod does not have yet.

## Details
$details

## How I verified
$evidence
Operator: not applicable - a branch sync with no code change

Assisted-by: $assisted
EOF
)
if [ -n "$bodyout" ]; then printf '%s\n' "$body" > "$bodyout"; else printf '%s\n' "$body"; fi

if [ "$open" = 1 ]; then
  if [ "$ff" -eq 0 ]; then git push -q -u origin "$b"; fi
  P=$(printf '%s' "$prefix" | tr '[:lower:]' '[:upper:]')
  pr=$(gh api "repos/$repo/pulls" -f "title=[$P-$issue] $subject" -f "head=$b" -f "base=$prod" \
    -f "body=$body" --jq .number)
  echo "ISSUE=$issue PR=$pr BRANCH=$b SHA=$sha" >&2
fi
