#!/usr/bin/env python3
"""Deploy accepted inert bytes with a trusted Wrangler 4.135.0 installation.

Arguments name private inputs outside Git. Use existing data and Access acquisitions.
Existing Previews and pending uploads require separate ownership reconciliation.
The trusted config artifact_manifest_sha256 must come from the manifest inside
the original archive after its digest matches the intake pin. Do not derive this
trust value from the mutable extracted directory.
A receipt proves native deployment identity only. Live acceptance remains separate.
"""
import argparse
from contextlib import contextmanager, ExitStack
import fcntl
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import runpy
import stat
import subprocess
import sys
import tempfile
import urllib.request

HERE = Path(__file__).resolve().parent
P = runpy.run_path(str(HERE / 'worker-preview-provision'))
A = runpy.run_path(str(HERE / 'worker-preview-access'))
L = runpy.run_path(str(HERE / 'worker-preview-plan'))


def require(condition):
    if not condition:
        raise ValueError('deployment trust check failed')


def private(path, directory=False):
    require(path.is_absolute() and not path.is_symlink())
    for ancestor in (path, *path.parents):
        require(not ancestor.is_symlink() and not (ancestor / '.git').exists())
    info = path.stat()
    require(info.st_uid == os.getuid() and not info.st_mode & 0o077)
    require(stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode))
    return path


def load(path):
    private(path)
    return A['load_json'](path, 'private input')


def digest(data):
    return hashlib.sha256(data).hexdigest()


def api(account, token, path, envelope=False):
    request = urllib.request.Request(A['API'] + (path if path.startswith('/accounts/') else '/accounts/' + account + path),
        headers={'Authorization': 'Bearer ' + token}, method='GET')
    # Reject redirects: readback must come from the exact API origin and route.
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            raise ValueError('API redirect rejected')
    opener = urllib.request.build_opener(NoRedirect)
    with opener.open(request, timeout=30) as response:
        value = json.loads(response.read(1024 * 1024 + 1), object_pairs_hook=A['no_duplicates'])
    require(value.get('success') is True)
    return value if envelope else value['result']


def child(command, environment, cwd):
    result = subprocess.run(command, env=environment, cwd=cwd, capture_output=True,
                            timeout=180, text=True)
    require(result.returncode == 0 and len(result.stdout) <= 1024 * 1024)
    return result.stdout


@contextmanager
def leases(paths):
    with ExitStack() as stack:
        for path in paths:
            descriptor = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
            stack.callback(os.close, descriptor)
            private(path)
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield


def deploy(args, progress):
    intake = private(args.intake, True)
    state = private(args.state, True)
    output = private(args.output, True)
    require(all(not path.resolve().is_relative_to(intake) for path in (args.plan, args.config, args.access_config, state, output, args.credentials, args.secrets)))
    pin = load(intake / 'intake.json')
    L['validate_pin'](pin)
    plan = P['validate_shape'](load(args.plan), True)
    owner = plan['owner']
    require(owner == {key: pin[key] for key in P['OWNER_KEYS']})
    cfg, ac = load(args.config), load(args.access_config)
    require(set(cfg) == {'github_cli', 'github_cli_sha256', 'artifact_manifest_sha256', 'wrangler', 'wrangler_sha256', 'compatibility_date', 'compatibility_flags', 'asset_binding', 'vars', 'secret_names'})
    require(isinstance(cfg['compatibility_date'], str) and re.fullmatch(r'20[0-9]{2}-[0-9]{2}-[0-9]{2}', cfg['compatibility_date']))
    require(isinstance(cfg['vars'], dict) and isinstance(cfg['secret_names'], list))
    require(isinstance(cfg['compatibility_flags'], list) and all(isinstance(flag, str) and re.fullmatch(r'[a-z][a-z0-9_]*', flag) for flag in cfg['compatibility_flags']))
    require(cfg['asset_binding'] is None or isinstance(cfg['asset_binding'], str) and P['BINDING'].fullmatch(cfg['asset_binding']))
    names = [*cfg['vars'], *cfg['secret_names'], *([cfg['asset_binding']] if cfg['asset_binding'] else [])]
    require(all(isinstance(name, str) and P['BINDING'].fullmatch(name) for name in names))
    bindings = [item['binding'] for kind in P['KINDS'] for item in plan['intended'][kind]]
    require(len(set(names + bindings)) == len(names + bindings))
    require(all(isinstance(value, str) for value in cfg['vars'].values()))
    desired = A['validate'](plan, ac)
    account = ac['account_id']
    stem = f"{account}-{digest(owner['repository'].encode())[:16]}-pr-{owner['pull_request']}"
    data_path = state / (stem + '.json')
    _, access_path, _ = A['scope_paths'](state, account, owner)
    with leases([state / (stem + '.lock'), state / ('.access-' + stem + '.lock')]):
        data = P['validate_shape'](load(data_path), False)
        access = load(access_path)
        require(data['owner'] == owner and data['intended'] == plan['intended'])
        require(not os.path.lexists(state / (stem + '.pending')))
        require(access.get('schema') == 1 and access.get('owner') == owner)
        require(access.get('identity') == A['identity'](desired) and access.get('pending') is None)
        require(access.get('reconcile_after') == 0 and access.get('token_candidate') is None and access.get('token_snapshot') is None)
        require(isinstance(access.get('access'), dict) and set(access['access']) == A['STATE_IDS'])
        require(all(isinstance(value, str) and A['OPAQUE'].fullmatch(value) for value in access['access'].values()))
        for kind in P['KINDS']:
            require(all(record['name' if kind == 'r2' else 'id'] is not None for record in data['acquired'][kind].values()))
        bundle = private(intake / 'bundle', True)
        manifest = load(bundle / 'artifact-manifest.json')
        require(digest((bundle / 'artifact-manifest.json').read_bytes()) == cfg['artifact_manifest_sha256'])
        expected = {key: pin[key] for key in ('schema', 'repository', 'pull_request', 'head_sha', 'branch')}
        require(set(manifest) == set(expected) | {'files'} and all(manifest[key] == value for key, value in expected.items()))
        files = manifest['files']
        require(isinstance(files, dict) and 'worker/worker.js' in files and len(files) <= 50000)
        payload, expanded = {}, 0
        for name, sha in files.items():
            require(isinstance(name, str) and isinstance(sha, str) and L['DIGEST'].fullmatch(sha))
            path = PurePosixPath(name)
            require(path.as_posix() == name and not path.is_absolute() and '..' not in path.parts and len(path.parts) > 1)
            require(path.parts[0] in {'worker', 'assets', 'migrations'})
            if path.parts[0] == 'worker':
                require(path.suffix in {'.js', '.mjs', '.wasm', '.txt', '.bin'})
            content = private(bundle / name).read_bytes()
            require(len(content) <= 256 * 1024**2 and 'sha256:' + digest(content) == sha)
            expanded += len(content)
            require(expanded <= 1024**3)
            payload[name] = content
        require(any(name.startswith('assets/') for name in payload) == bool(cfg['asset_binding']))
        actual = set()
        for path in bundle.rglob('*'):
            private(path, path.is_dir())
            if path.is_file():
                actual.add(path.relative_to(bundle).as_posix())
        require(actual == set(files) | {'artifact-manifest.json'})
        executables = {}
        for key in ('wrangler', 'github_cli'):
            path = Path(cfg[key])
            require(path.is_absolute() and not path.is_symlink() and path.is_file())
            require(not path.resolve().is_relative_to(intake) and not path.stat().st_mode & 0o022)
            require(digest(path.read_bytes()) == cfg[key + '_sha256'])
            executables[key] = str(path)
        executable, github = executables['wrangler'], executables['github_cli']
        clean = {'PATH': '/usr/bin:/bin', 'CI': 'true', 'WRANGLER_SEND_METRICS': 'false'}
        with tempfile.TemporaryDirectory(prefix='.deploy-', dir=output) as temporary:
            neutral = Path(temporary)
            clean['HOME'] = str(neutral)
            def current_head():
                current = json.loads(child([github, 'api', f"repos/{owner['repository']}/pulls/{owner['pull_request']}"],
                    {'PATH': '/usr/bin:/bin', 'HOME': os.environ.get('HOME', '')}, neutral))
                require(current.get('state') == 'open' and current['head']['sha'] == owner['head_sha'])
                require(current['head']['ref'] == owner['branch'] and all(current[key]['repo']['full_name'] == owner['repository'] for key in ('head', 'base')))
            current_head()
            require(child([str(executable), '--version'], clean, neutral).strip() == '4.135.0')
            pending, receipt_path = state / ('.deploy-' + stem + '.pending'), state / ('.deploy-' + stem + '-' + owner['head_sha'] + '-' + cfg['artifact_manifest_sha256'] + '.receipt.json')
            require(not os.path.lexists(pending) and not os.path.lexists(receipt_path))
            secret = load(args.secrets)
            require(set(secret) == set(cfg['secret_names']))
            require(all(isinstance(value, str) and value for value in secret.values()))
            credentials = load(args.credentials)
            require(set(credentials) == {'account_id', 'api_token'} and credentials['account_id'] == account)
            token = credentials['api_token']
            require(isinstance(token, str) and token and '\n' not in token)
            class ReadOnly(P['Cloudflare']):
                def request(self, method, path, body=None):
                    require(method == 'GET' and body is None)
                    return api(account, token, path, envelope=True)
            resources = ReadOnly(account, token)
            for kind in P['KINDS']:
                for item in plan['intended'][kind]:
                    require(P['exact'](resources, kind, item['name']) == data['acquired'][kind][item['binding']]['name' if kind == 'r2' else 'id'])
            ids = access['access']
            desired['service_policy']['include'][0]['service_token']['token_id'] = ids['service_token_id']
            for route, kinds in [('/access/apps', ['application']),
                ('/access/apps/' + ids['application_id'] + '/policies', ['human_policy', 'service_policy']),
                ('/access/service_tokens', ['service_token'])]:
                listed = A['Cloudflare'].list(resources, route.lstrip('/'))
                matches = [item for item in listed if isinstance(item, dict) and any(item.get('id') == ids[kind + '_id'] for kind in kinds)]
                require(len(matches) == len(kinds))
                if 'human_policy' in kinds:
                    require(len(listed) == 2)
                for kind in kinds:
                    require(any(item.get('id') == ids[kind + '_id'] and A['matches'](item, desired[kind]) for item in matches))
                if kinds == ['application']:
                    require(len([item for item in listed if item.get('domain') == plan['intended']['preview']['hostname']]) == 1)
            worker = plan['intended']['target_worker']['name']
            base = '/workers/workers/' + worker
            api(account, token, base)  # Refuse implicit creation of the parent Worker.
            subdomain = api(account, token, '/workers/scripts/' + worker + '/subdomain')
            require(subdomain.get('enabled') is False and subdomain.get('previews_enabled') is False)
            try:
                api(account, token, base + '/previews/' + owner['branch'])
            except A['urllib'].error.HTTPError as error:
                require(error.code == 404)
            else:
                raise ValueError('existing Preview requires ownership reconciliation')
            configuration = dict(name=worker, account_id=account, main=str(neutral / 'worker/worker.js'),
                compatibility_date=cfg['compatibility_date'], no_bundle=True, find_additional_modules=True,
                workers_dev=False, preview_urls=False, compatibility_flags=cfg['compatibility_flags'], previews={'vars': cfg['vars']})
            for kind, key, field in [('d1', 'd1_databases', 'database_id'), ('kv', 'kv_namespaces', 'id'), ('r2', 'r2_buckets', 'bucket_name')]:
                configuration['previews'][key] = [dict(binding=item['binding'], **{field: data['acquired'][kind][item['binding']]['name' if kind == 'r2' else 'id']}) for item in plan['intended'][kind]]
            configuration['rules'] = [dict(type=kind, globs=patterns, fallthrough=True) for kind, patterns in
                [('ESModule', ['**/*.js', '**/*.mjs']), ('CompiledWasm', ['**/*.wasm']), ('Text', ['**/*.txt']), ('Data', ['**/*.bin'])]]
            for name, content in payload.items():
                if name.startswith('migrations/'):
                    continue
                target = neutral / name
                target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
                target.write_bytes(content)
                target.chmod(0o600)
            if (neutral / 'assets').exists():
                configuration['assets'] = {'directory': str(neutral / 'assets'), 'binding': cfg['asset_binding']}
            config_path, secret_path = neutral / 'wrangler.json', neutral / 'secrets.json'
            P['atomic_write'](config_path, configuration, True)
            P['atomic_write'](secret_path, secret, True)
            clean.update(CLOUDFLARE_ACCOUNT_ID=account, CLOUDFLARE_API_TOKEN=token, GITHUB_SHA=owner['head_sha'])
            intent = dict(schema=1, owner=owner, artifact_manifest_sha256=cfg['artifact_manifest_sha256'], resource_digest=digest(json.dumps([data, access], sort_keys=True).encode()))
            current_head()
            P['atomic_write'](pending, intent, True)
            progress['upload_started'] = True
            result = json.loads(child([str(executable), 'preview', '--config', str(config_path),
                '--name', owner['branch'], '--worker-name', worker, '--ignore-base-config',
                '--secrets-file', str(secret_path), '--json'], clean, neutral))
            preview, deployment = result['preview'], result['deployment']
            require(preview['name'] == owner['branch'] and preview['worker_name'] == worker)
            for identifier in (preview['id'], deployment['id']):
                require(isinstance(identifier, str) and A['OPAQUE'].fullmatch(identifier))
            remote_preview = api(account, token, base + '/previews/' + preview['id'])
            for value in (preview, remote_preview):
                require(value['id'] == preview['id'] and value['name'] == owner['branch'] and value['worker_name'] == worker)
                require(value['urls'] == ['https://' + plan['intended']['preview']['hostname']])
            verified = api(account, token, base + '/previews/' + preview['id'] + '/deployments/' + deployment['id'])
            for value in (deployment, verified):
                require(value['id'] == deployment['id'] and value['preview_id'] == preview['id'] and value['preview_name'] == owner['branch'])
                require(value['annotations']['workers/commit_sha'] == owner['head_sha'])
                require(isinstance(value.get('urls', []), list) and all(isinstance(url, str) for url in value.get('urls', [])))
            current_head()
            receipt = dict(intent, deployment_id=verified['id'], preview_id=preview['id'],
                hostname=plan['intended']['preview']['hostname'], status='native-deployment-verified')
            P['atomic_write'](receipt_path, receipt, True)
            pending.unlink()
            P['sync_directory'](state)
            return receipt


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ('intake', 'plan', 'config', 'access_config', 'state', 'output', 'credentials', 'secrets'):
        parser.add_argument(name, type=Path)
    progress = {}
    try:
        receipt = deploy(parser.parse_args(), progress)
    except Exception:
        code = 'upload-incomplete-reconcile-pending' if progress.get('upload_started') else 'preflight-rejected-no-upload'
        print('error: ' + code, file=sys.stderr)
        return 1
    print(json.dumps(receipt, sort_keys=True))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
