#!/usr/bin/env bash
# Start (or reuse) an ascii.dev Box that is ready to WORK on a repo, and run the
# work there instead of on the laptop.
#
# The point is not speed of a single task. It is that a Box is a whole other
# 4 vCPU / 8 GB machine, so N of them run N jobs at once without the laptop
# swapping. The cap is 100 concurrent Boxes; the real limit is 50 starts/hour.
#
# A Box started this way has, in ~15s and with nothing uploaded:
#   - the repo cloned at its default branch        (box env add-repo)
#   - the gitignored env files .crabbox-secrets declares (box env set-file)
#   - TURBO_API / TURBO_TOKEN / TURBO_TEAM         (box env set-var)
#   - claude, codex, gemini, kimi, pi, muse        (agent-roster-ready snapshot)
#
# Usage
#   box-work <repo>                    start or reuse a Box, sync local edits, print how to enter
#   box-work <repo> --agent pi "brief" run one agent headlessly on the Box and print its output
#   box-work <repo> --manifest m.json [--agent ...] validate the dispatch manifest first; invalid stops before any Box call
#   box-work <repo> --ssh              open a shell on the Box
#   box-work <repo> --stop             stop this repo's Box
#   box-work --list                    every Box this tool started, and what it costs
#   box-work --stop-all                stop all of them
set -uo pipefail
export PATH="$HOME/.ascii/bin:$PATH"
BOX="${BOX_CLI:-$HOME/.ascii/bin/box}"   # BOX_CLI lets tests inject a stub
SNAPSHOT="${BOX_WORK_SNAPSHOT:-agent-roster-ready}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/box-work"
mkdir -p "$STATE"; chmod 700 "$STATE"

die() { echo "box-work: $*" >&2; exit 1; }

resolve_repo() {   # accept a directory or a bare repo name
  local a="$1"
  if [[ -d "$a" ]]; then
    git -C "$a" rev-parse --show-toplevel 2>/dev/null && return
  fi
  # a bare name: find a local clone whose remote matches
  local d
  for root in "$HOME/Documents/Personal" "$HOME/code" "$HOME/nova-wt"; do
    [[ -d "$root" ]] || continue
    while IFS= read -r g; do
      d="$(dirname "$g")"
      case "$d" in *"/worktrees/"*|*/node_modules/*) continue ;; esac
      if [[ "$(basename -s .git "$(git -C "$d" remote get-url origin 2>/dev/null)")" == "$a" ]]; then
        printf '%s\n' "$d"; return
      fi
    done < <(find "$root" -maxdepth 4 -name .git 2>/dev/null)
  done
  return 1
}

list_boxes() {
  printf '%-26s %-14s %-9s %s\n' REPO BOX STATE URL
  local f name id info
  for f in "$STATE"/*.id; do
    [[ -e "$f" ]] || continue
    name="$(basename "$f" .id)"; id="$(tr -d '[:space:]' < "$f")"
    info="$("$BOX" info "$id" --json 2>/dev/null | python3 -c '
import sys,json
try:
    b=json.load(sys.stdin)["box"]; print(b.get("state","?"), b.get("url","-"))
except Exception: print("gone -")' )"
    printf '%-26s %-14s %s\n' "$name" "$id" "$info"
  done
}

case "${1:-}" in
  ""|-h|--help) sed -n '2,25p' "$0"; exit 0 ;;
  --list) list_boxes; exit 0 ;;
  --stop-all)
    for f in "$STATE"/*.id; do
      [[ -e "$f" ]] || continue
      id="$(tr -d '[:space:]' < "$f")"
      # Only forget the Box once it is actually stopped. Dropping the id on a
      # failed stop leaves a RUNNING Box that nothing tracks any more -- and
      # nothing will ever stop it.
      if "$BOX" stop "$id" >/dev/null 2>&1; then
        echo "stopped $(basename "$f" .id) ($id)"; rm -f "$f"
      else
        echo "FAILED to stop $(basename "$f" .id) ($id) -- keeping the id so you can retry" >&2
      fi
    done
    exit 0 ;;
esac

TARGET="$1"; shift
REPO_DIR="$(resolve_repo "$TARGET")" || die "no local clone found for '$TARGET'"
REMOTE="$(git -C "$REPO_DIR" remote get-url origin 2>/dev/null || true)"
case "$REMOTE" in
  *Mozilla-Ocho*|*mozilla-ocho*|*mozilla.org*|*moz-ocho*)
    die "REFUSING: $REMOTE is a work repo. Boxes are personal-only." ;;
  *pooriaarab/*) : ;;
  *) die "REFUSING: $REMOTE is not a pooriaarab remote." ;;
esac
NAME="$(basename -s .git "$REMOTE")"
IDFILE="$STATE/$NAME.id"

MODE=start; AGENT=""; BRIEF=""; MANIFEST=""
while (( $# )); do
  case "$1" in
    --stop) MODE=stop; shift ;;
    --ssh) MODE=ssh; shift ;;
    --manifest) MANIFEST="${2:-}"; shift 2 || shift $# ;;
    --agent) MODE=agent; AGENT="${2:-}"; BRIEF="${3:-}"; shift 3 || shift $# ;;
    *) die "unknown argument: $1" ;;
  esac
done

if [[ "$MODE" == stop ]]; then
  [[ -f "$IDFILE" ]] || die "no Box recorded for $NAME"
  id="$(tr -d '[:space:]' < "$IDFILE")"
  if "$BOX" stop "$id" >/dev/null 2>&1; then
    # Keep the id: the next start resumes this Box instead of creating another. Stopped
    # Boxes are free, so a kept id costs nothing and saves a create.
    echo "stopped $NAME ($id); id kept so the next start resumes it"; exit 0
  fi
  echo "FAILED to stop $NAME ($id) -- keeping the id so you can retry" >&2
  exit 1
fi

# A declared manifest is validated before any Box, branch, or worker mutation:
# an invalid dispatch never reaches reuse, start, sync, or exec below.
if [[ -n "$MANIFEST" && "$MODE" != stop ]]; then
  VALIDATE="${WORKER_DISPATCH_VALIDATE:-$(cd "$(dirname "$0")" && pwd)/worker-dispatch-validate}"
  "$VALIDATE" --manifest "$MANIFEST" --checkout "$REPO_DIR" \
    || die "dispatch manifest invalid; refusing to touch a Box"
fi

# Reuse a live Box before starting another. Starts are capped at 50/hour, and a
# second Box for the same repo is pure waste.
ID=""
if [[ -f "$IDFILE" ]]; then
  cand="$(tr -d '[:space:]' < "$IDFILE")"
  st="$("$BOX" info "$cand" --json 2>/dev/null | python3 -c '
import sys,json
try: print(json.load(sys.stdin)["box"].get("state",""))
except Exception: print("")')"
  case "$st" in
    ready|idle|running) ID="$cand"; echo "[box-work] reusing $NAME box $ID ($st)" ;;
    stopped|archived)
      if "$BOX" resume "$cand" >/dev/null 2>&1; then
        ID="$cand"; echo "[box-work] resumed $NAME box $ID"
      else
        # Keep the id: a resume can fail transiently (network blip, API hiccup), and
        # forgetting it here would force a fresh ~100s create with no way back if that
        # create also fails. Worst case we retry the resume next start.
        echo "[box-work] $cand could not be resumed; will retry next start" >&2
      fi ;;
    *)
      # Empty state means either the Box is gone from the account or `box info` itself
      # failed transiently -- the exception handler above can't tell them apart. Don't
      # guess: forgetting a live id on a false positive throws away a resumable Box
      # forever, which is the exact bug this PR fixes. Leave it recorded. This is NOT
      # self-healing if the Box really is gone: nothing here distinguishes that from a
      # transient hiccup, so every future start hits the same unresolved state and
      # refuses the same way -- see the die message below for the manual way out.
      echo "[box-work] could not confirm state of $cand; leaving it recorded" >&2 ;;
  esac
  # A recorded id that we could not confirm or resume must not fall through to the
  # create path below -- that would start a duplicate Box AND overwrite $IDFILE with
  # its id, permanently losing the original instead of retrying it next start.
  [[ -n "$ID" ]] || die "$NAME box $cand is not usable right now (see above). If a retry keeps failing, confirm with 'box info $cand' -- if it's really gone, 'rm $IDFILE' to let the next start create a fresh one."
fi

if [[ -z "$ID" ]]; then
  echo "[box-work] starting a Box for $NAME (snapshot=$SNAPSHOT environment=$NAME)"
  stream="$(mktemp)"
  "$BOX" new --json --from "$SNAPSHOT" --environment "$NAME" > "$stream" 2>&1
  ID="$(python3 -c '
import sys,json
for line in open(sys.argv[1]):
    line=line.strip()
    if not line: continue
    try: d=json.loads(line)
    except Exception: continue
    if str(d.get("id","")).startswith("bx_"): print(d["id"]); break
' "$stream")"
  rm -f "$stream"
  [[ -n "$ID" ]] || die "could not start a Box for $NAME"
  printf '%s\n' "$ID" > "$IDFILE"
fi

# Wait for the Box to answer, then push whatever is uncommitted here. The Box
# already has the committed tree from GitHub; only local edits are missing.
#
# A Box can emit `ready` before its first exec succeeds (HTTP 409
# box_starting): retry the RECORDED id with a bounded deadline, never creating
# a replacement, from explicit --cwd (pruning can remove the default cwd).
ready=0
ready_deadline="${BOX_WORK_READY_SECS:-300}"
ready_start="$(date +%s)"
while (( $(date +%s) - ready_start < ready_deadline )); do
  if "$BOX" exec --cwd /home/user "$ID" -- true >/dev/null 2>&1; then ready=1; break; fi
  sleep 5
done
(( ready )) || die "Box $ID never answered within ${ready_deadline}s. It may still be starting; retry, or 'box info $ID'."

ATTACH="$HOME/Documents/Personal/scripts/box-fast-attach"
[[ -x "$ATTACH" ]] || ATTACH="$HOME/.local/bin/box-fast-attach"
if [[ -x "$ATTACH" ]]; then
  # A failed sync means the Box holds a stale tree. Saying "ready" then would
  # send an agent at the wrong code, which is worse than stopping here.
  ( cd "$REPO_DIR" && BOX_REMOTE_DIR="/home/user/$NAME" "$ATTACH" --box "$ID" 2>&1 | sed 's/^/[sync] /'
    exit "${PIPESTATUS[0]}" ) || die "sync to $ID failed; the Box tree may be stale."
else
  echo "[box-work] warning: box-fast-attach not found; the Box has the committed tree only" >&2
fi

case "$MODE" in
  ssh)   exec "$BOX" ssh "$ID" ;;
  agent)
    [[ -n "$AGENT" && -n "$BRIEF" ]] || die "--agent needs a CLI name and a brief"
    runner="$(mktemp)"
    # Bake the caller's heartbeat knobs into the runner as safe double-quoted
    # literals: a raw value containing `$`, a backtick, `"` or `\` must never
    # resurface as executable syntax when the uploaded script is parsed a
    # second time, on the Box.
    hb_dq_escape() {
      local s="$1"
      s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//\$/\\\$}"; s="${s//\`/\\\`}"
      printf '%s' "$s"
    }
    HB_FILE_ESC="$(hb_dq_escape "${BOX_WORK_HEARTBEAT_FILE:-/home/user/.box-reap-heartbeat}")"
    HB_SECS_ESC="$(hb_dq_escape "${BOX_WORK_HEARTBEAT_SECS-30}")"
    # Never a bare `claude`: ascii injects its own CLAUDE_CODE_OAUTH_TOKEN and
    # that silently bills the wrong subscription.
    cat > "$runner" <<RUNNER
#!/usr/bin/env bash
# One canonical dispatch path: every agent runs headless through verified
# flags, with explicit auth and loud failures -- no silent fallback.
export PATH="\$HOME/.local/bin:\$HOME/.kimi-code/bin:\$HOME/.npm-global/bin:\$PATH"
# Shared roster values, exported not just sourced. devin.env is never sourced
# (personal login needs API vars unset); cursor.env is required and sourced by
# its own branch, never trusted from ambient env.
set -a
[ -f "\$HOME/.agents/agent-clis.env" ] && . "\$HOME/.agents/agent-clis.env"
set +a
# On the Box $HOME is /home/user, so this is the same cwd there; going
# through $HOME (not a literal) lets tests run the runner under a
# fixture-owned home instead of a fixed /home/user path.
cd "\$HOME/$NAME" || exit 1
# Job-scoped liveness: box-reap never reaps on state alone, and a worker
# waiting on a provider looks idle by CPU. Touch the in-Box heartbeat while
# the agent runs; the EXIT trap stops updates when the job ends, so a dead
# job's file goes stale and keeps no exemption. The helper also exits when
# its parent is gone, a zombie, or a recycled PID (identity plus start-time
# check), so even an uncatchable kill leaves no orphan.
HEARTBEAT_FILE="$HB_FILE_ESC"
HEARTBEAT_SECS="$HB_SECS_ESC"
case "\$HEARTBEAT_SECS" in ''|*[!0-9]*)
  echo "box-work-run: invalid BOX_WORK_HEARTBEAT_SECS \"\$HEARTBEAT_SECS\": positive integer seconds required" >&2
  exit 2 ;;
esac
# All-zero digit strings (0, 00, 000, ...) are numeric but not positive: a
# zero sleep would spin the helper tight, so every zero-only form fails.
_hb_nozero="\${HEARTBEAT_SECS//0/}"
if [ -z "\$_hb_nozero" ]; then
  echo "box-work-run: invalid BOX_WORK_HEARTBEAT_SECS \"\$HEARTBEAT_SECS\": positive integer seconds required" >&2
  exit 2
fi
touch "\$HEARTBEAT_FILE" 2>/dev/null || echo "box-work-run: warning: cannot touch \$HEARTBEAT_FILE; idle-reaper exemption inactive" >&2
command -v ps >/dev/null 2>&1 || { echo "box-work-run: ps is required for heartbeat identity but not found" >&2; exit 2; }
HEARTBEAT_PPID=\$$
HEARTBEAT_START="\$(ps -o lstart= -p \$HEARTBEAT_PPID 2>/dev/null)"
[ -n "\$HEARTBEAT_START" ] || { echo "box-work-run: cannot determine parent start time (ps -o lstart failed)" >&2; exit 2; }
# Identity, not PID alone: zombies and recycled PIDs end the exemption.
( exec bash -c '
  _hp_pid="\$1"; _hp_start="\$2"; _hp_secs="\$3"; _hp_file="\$4"; warned=0
  _hp_alive() {
    _st="\$(ps -o stat= -p \$_hp_pid 2>/dev/null)" || return 1
    case "\$_st" in ""|*Z*) return 1;; esac
    _now="\$(ps -o lstart= -p \$_hp_pid 2>/dev/null)" || return 1
    [ "\$_now" = "\$_hp_start" ] || return 1
  }
  while _hp_alive; do
    sleep "\$_hp_secs"
    _hp_alive || break # parent may have exited mid-sleep: never touch then
    if touch "\$_hp_file" 2>/dev/null; then
      warned=0
    elif [ "\$warned" = 0 ]; then
      echo "box-work-run: warning: heartbeat touch failing for \$_hp_file; idle-reaper exemption may be inactive" >&2
      warned=1
    fi
  done
' box-work-heartbeat-loop "\$HEARTBEAT_PPID" "\$HEARTBEAT_START" "\$HEARTBEAT_SECS" "\$HEARTBEAT_FILE" ) &
HEARTBEAT_PID=\$!
stop_heartbeat() { kill "\$HEARTBEAT_PID" 2>/dev/null || true; wait "\$HEARTBEAT_PID" 2>/dev/null || true; }
kill_tree() { # list a process subtree's pids, deepest descendants first
  local _kt_p="\$1" _kt_c
  for _kt_c in \$(ps -o pid= --ppid "\$_kt_p" 2>/dev/null); do kill_tree "\$_kt_c"; done
  echo "\$_kt_p"
}
reap_tree() { # TERM the whole subtree, then SIGKILL survivors after a grace
              # period. Every PID's start time is recorded before TERM and
              # rechecked before KILL, so a recycled PID is never killed.
  local _rt_pids _rt_p _rt_id _rt_want _rt_st _rt_now _rt_map=""
  _rt_pids="\$(kill_tree "\$1")"
  for _rt_p in \$_rt_pids; do
    _rt_id="\$(ps -o lstart= -p "\$_rt_p" 2>/dev/null)"
    [ -n "\$_rt_id" ] && _rt_map="\$_rt_map
\$_rt_p \$_rt_id"
    kill -TERM "\$_rt_p" 2>/dev/null || true
  done
  sleep 1
  for _rt_p in \$_rt_pids; do
    _rt_want="\$(printf '%s\n' "\$_rt_map" | sed -n "s/^\$_rt_p //p")"
    [ -n "\$_rt_want" ] || continue
    _rt_st="\$(ps -o stat= -p "\$_rt_p" 2>/dev/null)" || continue
    case "\$_rt_st" in ""|*Z*) continue;; esac
    _rt_now="\$(ps -o lstart= -p "\$_rt_p" 2>/dev/null)" || continue
    [ "\$_rt_now" = "\$_rt_want" ] || continue
    kill -KILL "\$_rt_p" 2>/dev/null || true
  done
  true
}
trap stop_heartbeat EXIT
# The brief arrives base64-encoded. `box exec` joins argv into a shell command
# string, so a multi-word brief passed raw is split across argv and the agent
# receives only its first word -- it then asks a clarifying question and does
# nothing, while the call still reports success.
BRIEF="\$(printf %s "\$1" | base64 -d)"
set -- "\$BRIEF"
# The worker runs in the background under a short-poll supervisor so a trapped
# signal is answered promptly even when the agent itself would run on: the
# trap stops the agent and the heartbeat, then re-raises for exact status.
run_worker() {
case "$AGENT" in
  pi)     PI_WORKER=1 pi -p --no-extensions --provider zai-api --model glm-5.3-flash -a --tools read,grep,find,ls,edit,write,bash "\$1" ;;
  muse)
    # Headless: without --yolo the run can wait on an approval prompt and do
    # nothing while the call still reports success.
    brief_file="\$(mktemp)"
    printf '%s' "\$1" > "\$brief_file"
    muse exec --yolo --json --model muse-spark-1.3-contributor --workspace "/home/user/$NAME" --prompt-file "\$brief_file"
    rc=\$?
    rm -f "\$brief_file"
    exit \$rc ;;
  cursor)
    # Authoritative file required; ambient keys never authenticate.
    cursor_env="\$HOME/.agents/cursor.env"
    if [ ! -s "\$cursor_env" ]; then
      echo "box-work: cursor needs \$HOME/.agents/cursor.env (missing or empty); refusing an ambient CURSOR_API_KEY." >&2
      exit 1
    fi
    unset CURSOR_API_KEY
    set -a; . "\$cursor_env"; set +a
    if [ -z "\${CURSOR_API_KEY:-}" ]; then
      echo "box-work: cursor needs CURSOR_API_KEY exported by \$HOME/.agents/cursor.env (missing or empty)." >&2
      exit 1
    fi
    cursor-agent -p --trust --force --model composer-2.5 --output-format json "\$1" ;;
  devin)
    # Proven personal login only: API vars are scrubbed (current CLI ignores
    # them), no unproven API route is offered, no fallback.
    brief_file="\$(mktemp)"
    printf '%s' "\$1" > "\$brief_file"
    env -u DEVIN_API_KEY -u DEVIN_TOKEN -u WINDSURF_API_KEY devin --model swe-1.7 --respect-workspace-trust false --permission-mode dangerous --prompt-file "\$brief_file" -p
    rc=\$?
    rm -f "\$brief_file"
    exit \$rc ;;
  kimi)   kimi -m moonshot-ai/kimi-k3 -p "\$1" ;;
  codex)  codex exec "\$1" ;;
  gemini)
    # Canonical personal profile required; ambient/shared keys never qualify.
    gemini_env="\$HOME/.gemini-personal/.gemini/.env"
    if [ ! -s "\$gemini_env" ]; then
      echo "box-work: gemini needs \$HOME/.gemini-personal/.gemini/.env (missing or empty); refusing an ambient GEMINI_API_KEY." >&2
      exit 1
    fi
    unset GEMINI_API_KEY
    set -a; . "\$gemini_env"; set +a
    if [ -z "\${GEMINI_API_KEY:-}" ]; then
      echo "box-work: gemini needs GEMINI_API_KEY exported by \$HOME/.gemini-personal/.gemini/.env (missing or empty)." >&2
      exit 1
    fi
    env -u GOOGLE_GENAI_USE_VERTEXAI -u GOOGLE_APPLICATION_CREDENTIALS -u GOOGLE_CLOUD_PROJECT -u GOOGLE_CLOUD_LOCATION GEMINI_CLI_HOME="\$HOME/.gemini-personal" GEMINI_API_KEY="\$GEMINI_API_KEY" GEMINI_CLI_TRUST_WORKSPACE=true gemini --skip-trust --yolo -m gemini-3.8-flash -p "\$1" ;;
  *) echo "unsupported agent: $AGENT" >&2; exit 2 ;;
esac
}
run_worker "\$1" &
AGENT_PID=\$!
trap 'reap_tree "\$AGENT_PID"; stop_heartbeat; trap - EXIT INT TERM HUP; kill -INT \$\$' INT
trap 'reap_tree "\$AGENT_PID"; stop_heartbeat; trap - EXIT INT TERM HUP; kill -TERM \$\$' TERM
# HUP has no trap of its own by default, so an unhandled HUP would only run
# the bare EXIT trap above (stop_heartbeat) and leave the agent subtree
# orphaned; mirror the INT/TERM handling so HUP tears down the whole job too.
trap 'reap_tree "\$AGENT_PID"; stop_heartbeat; trap - EXIT INT TERM HUP; kill -HUP \$\$' HUP
# Short poll, not a bare `wait`: bash defers a trapped SIGINT until a waited-for
# child exits, so a bare wait would stall a PID-only interrupt for the whole
# agent lifetime. The 0.5s sleep bounds trap latency; `wait` still reaps the
# exact worker status afterwards.
while kill -0 "\$AGENT_PID" 2>/dev/null; do sleep 0.5; done
wait "\$AGENT_PID" 2>/dev/null; WORKER_RC=\$?
exit \$WORKER_RC
RUNNER
    "$BOX" scp "$runner" "$ID:/home/user/box-work-run.sh" >/dev/null 2>&1
    rm -f "$runner"
    b64brief="$(printf '%s' "$BRIEF" | base64 | tr -d '\n')"
    "$BOX" exec --cwd "/home/user/$NAME" "$ID" --timeout 580 --json -- bash /home/user/box-work-run.sh "$b64brief" \
      | python3 -c 'import sys,json
d=json.load(sys.stdin)
o=(d.get("stdout") or "").rstrip()
e=(d.get("stderr") or "").rstrip()
if o: print(o)
if e: print(e, file=sys.stderr)
sys.exit(d.get("exitCode") or 0)' 
    ;;
  start)
    url="$("$BOX" info "$ID" --json 2>/dev/null | python3 -c '
import sys,json
try: print(json.load(sys.stdin)["box"].get("url","-"))
except Exception: print("-")')"
    cat <<EOF

  $NAME is ready on $ID
    repo      /home/user/$NAME
    shell     box-work $NAME --ssh
    one agent box-work $NAME --agent pi "your brief"
    stop      box-work $NAME --stop
    url       $url

  Costs \$0.036/h while running. Default TTL is 60 minutes from start.
EOF
    ;;
esac
