#!/usr/bin/env bash
# Merge cursor-cloud rollout PRs when checks are green.
#
# Usage:
#   ./cursor-cloud-merge --dry-run
#   ./cursor-cloud-merge --merge-green
#   ./cursor-cloud-merge --babysit --merge-green
#
set -u
OWNER="pooriaarab"
DRY=1
MERGE_GREEN=0
BABYSIT=0

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1; shift ;;
    --merge-green) MERGE_GREEN=1; DRY=0; shift ;;
    --babysit) BABYSIT=1; shift ;;
    --apply) DRY=0; shift ;;
    --help|-h) sed -n '2,8p' "$0"; exit 0 ;;
    *) echo "unknown flag: $1"; exit 1 ;;
  esac
done

PRS=$(gh search prs "adopt-cursor-cloud is:open" --owner "$OWNER" \
  --json number,repository --limit 200 2>/dev/null) || {
  echo "FAIL  (gh search prs)"
  exit 1
}

merged_c=0
waiting_c=0
fail_c=0

process_pr() {
  local repo="$1" num="$2"
  local full="$OWNER/$repo"

  if [ "$BABYSIT" -eq 1 ] && [ "$MERGE_GREEN" -eq 1 ]; then
    gh pr checks "$num" --repo "$full" --watch --fail-fast 2>/dev/null || true
  fi

  if [ "$DRY" -eq 1 ] && [ "$MERGE_GREEN" -eq 0 ]; then
    echo "OPEN  $repo  PR #$num"
    waiting_c=$((waiting_c + 1))
    return 0
  fi

  # Use gh pr checks (latest state), not statusCheckRollup (includes stale failures).
  CHECK_OUT=$(gh pr checks "$num" --repo "$full" 2>&1) || CHECK_OUT=""
  if echo "$CHECK_OUT" | grep -qE '\tfail\t'; then
    echo "RED   $repo  PR #$num"
    fail_c=$((fail_c + 1))
    return 0
  fi
  if echo "$CHECK_OUT" | grep -qE '\tpending\t|\tin_progress\t'; then
    echo "WAIT  $repo  PR #$num  (checks pending)"
    waiting_c=$((waiting_c + 1))
    return 0
  fi

  MERGE_STATE=$(gh pr view "$num" --repo "$full" --json mergeable,mergeStateStatus \
    --jq '[.mergeable, .mergeStateStatus] | @tsv' 2>/dev/null || echo "")
  read -r MERGEABLE MERGE_STATUS <<< "$MERGE_STATE"
  if [ "$MERGE_STATUS" = "DIRTY" ] || [ "$MERGEABLE" = "CONFLICTING" ]; then
    echo "DIRTY $repo  PR #$num  (conflict)"
    fail_c=$((fail_c + 1))
    return 0
  fi

  if [ "$MERGE_GREEN" -eq 1 ]; then
    if gh pr merge "$num" --repo "$full" --squash --delete-branch 2>/dev/null; then
      echo "MERGE $repo  PR #$num"
      merged_c=$((merged_c + 1))
    else
      echo "BLOCK $repo  PR #$num  (merge rejected — likely needs approval or branch protection)"
      waiting_c=$((waiting_c + 1))
    fi
  else
    echo "GREEN $repo  PR #$num  (ready)"
    waiting_c=$((waiting_c + 1))
  fi
}

while IFS=$'\t' read -r repo num; do
  [ -z "$repo" ] && continue
  process_pr "$repo" "$num"
done < <(echo "$PRS" | python3 -c "
import json, sys
for pr in json.load(sys.stdin):
    repo = pr['repository']['nameWithOwner'].split('/')[-1]
    print(f\"{repo}\t{pr['number']}\")
")

echo ""
echo "=== Summary ==="
echo "merged: $merged_c  waiting: $waiting_c  failed/red: $fail_c"
