{
  "prefix": "__PREFIX__",
  "requireIssue": true,
  "allowChoreEscape": false,
  "maxLines": 500,
  "maxFiles": 40,
  "maxTopLevelDirs": 3,
  "minBodyChars": 120,
  "overrideLabel": "oversized-approved",
  "exemptBranches": ["main", "master", "release", "refactor", "gh-pages"],
  "excludeGlobs": [
    "**/*.lock",
    "**/package-lock.json",
    "**/bun.lockb",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/Cargo.lock",
    "dist/**",
    "build/**",
    "out/**",
    ".next/**",
    "vendor/**",
    "**/generated/**",
    "**/__snapshots__/**",
    "**/migrations/**",
    "**/*.snap",
    "**/*.generated.*",
    "**/*.min.js",
    "**/*.map",
    "**/*.{svg,png,jpg,jpeg,gif,webp,ico,woff,woff2,ttf,otf,mp4,pdf,zip}"
  ]
}
