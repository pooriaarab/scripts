#!/usr/bin/env bash
# Re-run pr-standards (or all) CI on open cursor-cloud PRs after body repair.
set -u
OWNER="pooriaarab"
DRY=1

while [ $# -gt 0 ]; do
  case "$1" in
    --apply) DRY=0; shift ;;
    *) echo "unknown flag: $1"; exit 1 ;;
  esac
done

PRS=$(gh search prs "adopt-cursor-cloud is:open" --owner "$OWNER" \
  --json number,repository --limit 200 2>/dev/null) || exit 1

echo "$PRS" | python3 -c "
import json, sys
for pr in json.load(sys.stdin):
    repo = pr['repository']['nameWithOwner'].split('/')[-1]
    print(f\"{repo}\t{pr['number']}\")
" | while IFS=$'\t' read -r repo num; do
  [ -z "$repo" ] && continue
  RUN=$(gh run list --repo "$OWNER/$repo" --workflow pr-standards --branch "$(gh pr view "$num" --repo "$OWNER/$repo" --json headRefName -q .headRefName 2>/dev/null)" --limit 1 --json databaseId,conclusion -q '.[0].databaseId' 2>/dev/null || echo "")
  if [ -z "$RUN" ]; then
    echo "SKIP  $repo  (no pr-standards run)"
    continue
  fi
  if [ "$DRY" -eq 1 ]; then
    echo "WOULD  $repo  rerun run $RUN"
  else
    gh run rerun "$RUN" --repo "$OWNER/$repo" 2>/dev/null && echo "RERUN $repo  run $RUN" || echo "FAIL  $repo"
  fi
done
