#!/usr/bin/env bash
# box-cost-log — track ascii.dev Box spend over time.
#   box-cost-log            append one timestamped snapshot to the log
#   box-cost-log report     summarize the log (usage deltas, active Boxes, $ burn)
# Wire the snapshot into launchd/cron every ~15 min to build a spend history.
#
# ascii billing model: credits are seconds. `creditSecondsPerDollar` (usually
# 100000) converts seconds->dollars. The $20 plan includes 2,000,000 sec/mo.
set -uo pipefail
export PATH="$HOME/.ascii/bin:$PATH"
LOG="${BOX_COST_LOG:-$HOME/.local/state/box-cost/usage.jsonl}"
mkdir -p "$(dirname "$LOG")"

snapshot() {
  local j; j="$(box limits --json 2>/dev/null)" || { echo "box-cost-log: box limits failed" >&2; exit 1; }
  printf '%s\n' "$j" | jq -c --arg ts "$(date -u +%FT%TZ)" '{
    ts: $ts,
    activeBoxes,
    creditUsedSeconds,
    creditBalanceSeconds,
    last24hUsageSeconds,
    liveUsageSeconds,
    perDollar: .creditSecondsPerDollar,
    subRemainingSeconds: .subscriptionRemainingSeconds
  }' >> "$LOG"
  echo "box-cost-log: snapshot appended to $LOG"
}

report() {
  [[ -s "$LOG" ]] || { echo "box-cost-log: no history yet at $LOG"; exit 0; }
  jq -rs '
    (.[-1].perDollar // 100000) as $pd
    | .[0] as $first | .[-1] as $last
    | ($last.creditUsedSeconds - $first.creditUsedSeconds) as $usedDelta
    | "Window:        \($first.ts)  ->  \($last.ts)",
      "Samples:       \(length)",
      "Active Boxes:  now \($last.activeBoxes)  (max \([.[].activeBoxes] | max))",
      "Credit used in window: \($usedDelta) sec  = $\(($usedDelta/$pd)*100|round/100)",
      "Last 24h usage:        \($last.last24hUsageSeconds) sec = $\((($last.last24hUsageSeconds)/$pd)*100|round/100)",
      "Credit remaining:      \($last.creditBalanceSeconds) sec = $\((($last.creditBalanceSeconds)/$pd)*100|round/100)",
      "Sub remaining (month): \($last.subRemainingSeconds) sec"
  ' "$LOG"
}

case "${1:-snapshot}" in
  snapshot) snapshot ;;
  report)   report ;;
  *) echo "usage: box-cost-log [snapshot|report]" >&2; exit 2 ;;
esac
