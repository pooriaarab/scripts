#!/usr/bin/env bash
# Sweep ascii.dev Boxes from a machine that is not the laptop.
#
# The launchd reaper on the laptop decides with evidence: it probes each Box over SSH and
# measures CPU and load. A CI runner cannot do that, so this sweeper knows strictly less —
# it decides on AGE alone. That is why it reports by default and stops nothing without
# --execute, and why the ceiling is generous.
#
# It talks to the REST API rather than the `box` CLI, because a runner has curl and python3
# and does not have the CLI. The base and paths below are verified, not guessed:
#   `box status` reports  apiUrl: https://ascii.dev
#   GET  /api/box/boxes            -> the same JSON shape as `box list --json`
#   POST /api/box/boxes/{id}/stop  -> stop
# An earlier attempt guessed api.ascii.dev, which does not resolve; every call failed and
# an empty result would have read as "no Boxes running".
set -euo pipefail

API_BASE="${ASCII_API_BASE:-https://ascii.dev/api/box}"
MAX_AGE_HOURS="${BOX_SWEEP_MAX_AGE_HOURS:-6}"
EXECUTE=0
JSON=0

usage() {
  cat <<'USAGE'
Usage: box-sweep-remote [--max-age-hours N] [--execute] [--json]

  --max-age-hours N   age ceiling in hours (default 6)
  --execute           stop Boxes over the ceiling (default: report only)
  --json              machine-readable output

Exit: 0 nothing over the ceiling, or a completed --execute sweep.
      1 something is over the ceiling and was left running.
      2 usage error.  3 the credential or the API is unusable.
USAGE
}

while (( $# )); do
  case "$1" in
    --max-age-hours)
      [[ $# -ge 2 ]] || { echo "--max-age-hours requires a value" >&2; usage >&2; exit 2; }
      MAX_AGE_HOURS="$2"
      shift 2
      ;;
    --execute) EXECUTE=1; shift ;;
    --json) JSON=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

# A non-finite ceiling is a loaded gun: NaN/inf makes every Box compare as "under", so
# --execute silently stops nothing. A negative ceiling is nonsensical. There is no shell-side
# pre-check for "looks like a number" — anything that is not a valid float (including
# garbage like "1.2.3") must be caught here, or it blows up inside the Python report as an
# unhandled ValueError (exit 3, not the documented usage-error exit 2).
if ! MAX_AGE_HOURS="$MAX_AGE_HOURS" python3 -c '
import os, sys
try:
    v = float(os.environ["MAX_AGE_HOURS"])
except ValueError:
    sys.exit(1)
sys.exit(0 if 0 <= v < float("inf") else 1)
'; then
  echo "FATAL: --max-age-hours must be a non-negative, finite number, got '$MAX_AGE_HOURS'" >&2
  exit 2
fi

[[ -n "${ASCII_BOX_API_KEY:-}" ]] || { echo "FATAL: ASCII_BOX_API_KEY is not set." >&2; exit 3; }

# The key goes in a header file, never on the command line: a runner archives its logs and
# `ps` is readable by anything else on the box.
auth_header="$(mktemp)"
trap 'rm -f "$auth_header" "${over_file:-}"' EXIT
printf 'Authorization: Bearer %s\n' "$ASCII_BOX_API_KEY" > "$auth_header"

# An enumeration failure must never look like an empty account: "no Boxes" and "cannot see
# Boxes" lead to opposite conclusions and only one is safe to act on.
if ! raw="$(curl --silent --show-error --fail --max-time 60 -H @"$auth_header" "$API_BASE/boxes" 2>&1)"; then
  echo "FATAL: could not list Boxes: ${raw:0:200}" >&2
  exit 3
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
over_file="$(mktemp)"
if ! report="$(printf '%s' "$raw" | MAX_AGE_HOURS="$MAX_AGE_HOURS" JSON="$JSON" \
    python3 "$here/box_sweep_report.py" 2>"$over_file")"; then
  echo "FATAL: could not parse the Box list: $(head -3 "$over_file")" >&2
  exit 3
fi

printf '%s\n' "$report"
over_ids="$(sed -n 's/^OVER_IDS=//p' "$over_file" | tr -s ' ')"

# Status lines go to stderr, never stdout: with --json, stdout must stay a single valid
# JSON document for machine consumers.
[[ -n "${over_ids// /}" ]] || { echo "Nothing over the ${MAX_AGE_HOURS}h ceiling." >&2; exit 0; }

if [[ "$EXECUTE" -ne 1 ]]; then
  echo "Report only. Re-run with --execute to stop:$over_ids" >&2
  exit 1
fi

# Stop, never delete. A stopped Box is free and keeps its snapshot; a deleted one is gone.
failed=0
for id in $over_ids; do
  if curl --silent --show-error --fail --max-time 60 -X POST -H @"$auth_header" \
      "$API_BASE/boxes/$id/stop" >/dev/null 2>&1; then
    echo "stopped $id" >&2
  else
    echo "FAILED to stop $id" >&2
    failed=1
  fi
done
exit "$failed"
