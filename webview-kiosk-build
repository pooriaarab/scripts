#!/usr/bin/env bash
# webview-kiosk-build — build a signed WebView APK with command-line tools only.
#
# No Android Studio, no Gradle. Uses javac + aapt2 + d8 + zipalign + apksigner
# from the Android command-line tools package.
#
# App dir layout expected (single-package Java source):
#   <app-dir>/AndroidManifest.xml
#   <app-dir>/res/…                  (mipmap launcher icon at minimum)
#   <app-dir>/assets/…               (web content: index.html etc.)
#   <app-dir>/src/<pkg-path>/*.java  (e.g. src/com/example/kiosk/MainActivity.java)
#   <app-dir>/<name>.keystore        (created on first build, then reused)
#
# USAGE:
#   webview-kiosk-build <app-dir> [package.name] [keystore-name]
# Env overrides: ANDROID_SDK_ROOT, JAVA_HOME, BUILD_TOOLS_VER, PLATFORM_VER
#
# WARNING: the keystore is the identity of the install. If the app is a device
# owner, a lost or regenerated keystore freezes the on-device build forever —
# keep the keystore outside any directory you ever `rm -rf`.
set -euo pipefail

APP_DIR="${1:?usage: webview-kiosk-build <app-dir> [package.name] [keystore-name]}"
PKG="${2:-com.example.kiosk}"
KS_NAME="${3:-kiosk.keystore}"

SDK="${ANDROID_SDK_ROOT:-/opt/homebrew/share/android-commandlinetools}"
BT="$SDK/build-tools/${BUILD_TOOLS_VER:-34.0.0}"
PLATFORM="$SDK/platforms/${PLATFORM_VER:-android-34}/android.jar"
JAVA_HOME="${JAVA_HOME:-/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home}"
export JAVA_HOME   # apksigner is a java wrapper — it reads JAVA_HOME from the env
PKG_PATH="${PKG//.//}"

cd "$APP_DIR"
[ -f AndroidManifest.xml ] || { echo "no AndroidManifest.xml in $APP_DIR" >&2; exit 1; }
[ -d "src/$PKG_PATH" ] || { echo "no sources at src/$PKG_PATH" >&2; exit 1; }

rm -rf build && mkdir -p build/gen build/obj "build/apk"

"$BT/aapt2" compile --dir res -o build/res.zip
"$BT/aapt2" link -o build/apk/base.apk -I "$PLATFORM" \
  --manifest AndroidManifest.xml -A assets --java build/gen \
  --min-sdk-version 24 --target-sdk-version 34 build/res.zip

"$JAVA_HOME/bin/javac" -source 11 -target 11 -classpath "$PLATFORM" \
  -d build/obj src/"$PKG_PATH"/*.java build/gen/"$PKG_PATH"/R.java

"$JAVA_HOME/bin/java" -cp "$BT/lib/d8.jar" com.android.tools.r8.D8 \
  --lib "$PLATFORM" --output build/apk build/obj/"$PKG_PATH"/*.class

(cd build/apk && zip -u base.apk classes.dex)
"$BT/zipalign" -f 4 build/apk/base.apk build/apk/aligned.apk

if [ ! -f "$KS_NAME" ]; then
  "$JAVA_HOME/bin/keytool" -genkeypair -keystore "$KS_NAME" -alias kiosk \
    -keyalg RSA -keysize 2048 -validity 10000 \
    -storepass android -keypass android -dname "CN=$PKG"
fi
"$BT/apksigner" sign --ks "$KS_NAME" --ks-pass pass:android \
  --out build/kiosk.apk build/apk/aligned.apk

echo "OK: $(stat -f%z build/kiosk.apk 2>/dev/null || stat -c%s build/kiosk.apk) bytes -> $APP_DIR/build/kiosk.apk"
