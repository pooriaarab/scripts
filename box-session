#!/usr/bin/env bash
# Warm a Box when an agent session starts, stop it when the session ends.
#
# This is the piece that makes Boxes automatic instead of a command you have to
# remember. Wire it as a Claude Code SessionStart/SessionEnd hook and every new
# session in an opted-in repo gets a Box warming in the background while you
# work, then releases it when you are done.
#
#   box-session start   # non-blocking: warms a Box for this repo in the background
#   box-session end     # stop the Box this repo warmed
#   box-session status  # is there one, and what is it costing
#
# OPT-IN, because a Box costs money and most sessions never need one. A repo
# opts in with a `.crabbox-default-on` marker at its root, the same marker the
# crabbox worktree path already uses. No marker, no Box, no cost.
#
# NON-BLOCKING, because a cold start is ~100s and a session must not wait on it.
# `start` forks and returns immediately. By the time you have read the diff and
# decided what to do, the Box is up. `box-work <repo>` then reuses it in ~4s.
set -uo pipefail
export PATH="$HOME/.ascii/bin:$PATH"

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/box-work"
BOXWORK="${BOX_WORK_BIN:-$HOME/.local/bin/box-work}"
[[ -x "$BOXWORK" ]] || BOXWORK="$HOME/Documents/Personal/scripts/box-work"

repo_root() { git rev-parse --show-toplevel 2>/dev/null; }
main_root() { git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -1; }

ROOT="$(repo_root)" || exit 0
[[ -n "$ROOT" ]] || exit 0
MAIN="$(main_root)"; [[ -n "$MAIN" ]] || MAIN="$ROOT"
REMOTE="$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)"

# ascii.dev is third-party. Work code never goes there, whatever the marker says.
case "$REMOTE" in
  *Mozilla-Ocho*|*mozilla-ocho*|*mozilla.org*|*moz-ocho*) exit 0 ;;
  *pooriaarab/*) : ;;
  *) exit 0 ;;
esac
NAME="$(basename -s .git "$REMOTE")"

case "${1:-status}" in
  start)
    [[ -f "$MAIN/.crabbox-default-on" || -f "$ROOT/.crabbox-default-on" ]] || exit 0
    # Already have a live one? Say so and stop.
    if [[ -f "$STATE/$NAME.id" ]]; then
      id="$(tr -d '[:space:]' < "$STATE/$NAME.id")"
      st="$(box info "$id" --json 2>/dev/null | python3 -c '
import sys,json
try: print(json.load(sys.stdin)["box"].get("state",""))
except Exception: print("")')"
      case "$st" in ready|idle|running) echo "[box-session] $NAME already has Box $id ($st)"; exit 0 ;; esac
    fi
    echo "[box-session] warming a Box for $NAME in the background (~100s; reuse is ~4s)"
    # Detach fully: the hook must not hold the session open.
    nohup "$BOXWORK" "$ROOT" >"$STATE/$NAME.warm.log" 2>&1 </dev/null &
    disown 2>/dev/null || true
    exit 0 ;;
  end)
    [[ -f "$STATE/$NAME.id" ]] || exit 0
    id="$(tr -d '[:space:]' < "$STATE/$NAME.id")"
    box stop "$id" >/dev/null 2>&1 && echo "[box-session] stopped $NAME Box $id"
    rm -f "$STATE/$NAME.id"
    exit 0 ;;
  status)
    if [[ -f "$STATE/$NAME.id" ]]; then
      id="$(tr -d '[:space:]' < "$STATE/$NAME.id")"
      box info "$id" --json 2>/dev/null | python3 -c '
import sys,json,datetime
b=json.load(sys.stdin)["box"]
c=datetime.datetime.fromisoformat(b["createdAt"].replace("Z","+00:00"))
now=datetime.datetime.now(datetime.timezone.utc)
h=(now-c).total_seconds()/3600
print("  %s  %s  up %.1fh  ~$%.3f so far" % (b["id"], b.get("state"), h, h*0.036))' 2>/dev/null \
        || echo "  $NAME: recorded Box $id is gone"
    else
      echo "  $NAME: no Box"
    fi
    exit 0 ;;
  *) echo "usage: box-session start|end|status" >&2; exit 2 ;;
esac
