#!/usr/bin/env bash
# box-agent — run ANY supported agent CLI on an ascii.dev Box, not the laptop.
# Multi-harness generalization of box-claude (Slice A).
#
# Two execution strategies:
#   NATIVE  (claude, codex)  -> `box prompt --provider <p>`  (ascii-managed auth,
#            bills ascii box credits, NOT your Claude/OpenAI sub). No per-CLI setup.
#   ON-BOX  (gemini, pi, kimi, cursor, devin) -> the CLI runs on the Box via
#            `box exec`. Requires that CLI already authed AND FUNDED on the Box;
#            box-agent's preflight only checks the binary is installed (`command -v`)
#            and REFUSES if it's missing — it can NOT detect an unauthed or unfunded
#            CLI, which will just run and produce no diff. See PROVIDER STATUS below.
#
# PROVIDER STATUS (validated on an agent-roster Box, 2026-09-04, judged on git diff):
#   claude  WORKS (native).
#   pi      WORKS (on-box) — but only with zai-api/glm-5.3-flash (no openrouter key
#           on the Box). Set below accordingly.
#   codex   HANGS on the Box (8+ min, no output) and blocks the box command channel;
#           box-agent runs it bounded and interrupts it. Treat as unreliable for now.
#   gemini  installed but the AI-Studio project is over its monthly cap (429); works
#           only once funded, and must run detached (foreground trips the HTTP timeout).
#   kimi    Moonshot account suspended/unfunded (429) — no diff until funded.
#   cursor  not logged in on the Box (no CURSOR_API_KEY) — needs auth on the Box.
#   devin   not installed; needs the OAuth credentials.toml on the Box (NOT the
#           exhausted .secrets api key). Command is wired below but UNTESTED —
#           no Box has had working devin credentials yet.
# So today the reliable providers are: claude, pi. The rest are wired but gated by
# funding/auth ON the Box — the preflight will tell you which.
#
# In every case the agent works on a fresh clone from origin (committed state),
# the diff is verified ON the Box (never trust exit code), pulled back as a patch,
# and the Box is stopped with confirmation (unless --keep/--reuse asks to leave it).
#
# USAGE (run inside the personal repo, or pass --repo owner/name):
#   box-agent codex "add a --json flag and update the README"
#   box-agent claude --model opus "refactor the parser"
#   box-agent gemini --repo pooriaarab/foo "fix the typo"
#   box-agent pi "..."      # pi/kimi/gemini/cursor/devin = on-box CLI path
# Flags: --model M  --reasoning-effort L  --repo owner/name  --reuse bx_x  --keep
set -euo pipefail
export PATH="$HOME/.ascii/bin:$PATH"
# BOX_BIN injects the box binary (tests point it at a stub) and BOX_CLI
# carries the same injector to box-provider-readiness. Neither touches HOME.
BOX_BIN="${BOX_BIN:-box}"
export BOX_CLI="${BOX_CLI:-$BOX_BIN}"
box() { command "$BOX_BIN" "$@"; }

PROVIDER="${1:-}"; shift || true
[[ -n "$PROVIDER" ]] || { echo "box-agent: first arg = provider (claude|codex|gemini|pi|kimi|cursor|devin)"; exit 2; }

MODEL=""; EFFORT=""; REUSE=""; KEEP=0; REPO=""; PROMPT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model|--reasoning-effort|--reuse|--repo)
      [[ $# -ge 2 ]] || { echo "box-agent: $1 needs a value" >&2; exit 2; }
      ;;
  esac
  case "$1" in
    --model) MODEL="$2"; shift 2 ;;
    --reasoning-effort) EFFORT="$2"; shift 2 ;;
    --reuse) REUSE="$2"; shift 2 ;;
    --repo) REPO="$2"; shift 2 ;;
    --keep) KEEP=1; shift ;;
    -h|--help) sed -n '2,27p' "$0"; exit 0 ;;
    *) PROMPT="$1"; shift ;;
  esac
done
[[ -n "$PROMPT" ]] || { echo "box-agent: need a prompt. See --help." >&2; exit 2; }

# on-box CLI invocation forms (headless). %REPO% is replaced with the clone path.
onbox_cmd() {
  case "$1" in
    gemini) echo "gemini --skip-trust -y -p" ;;
    pi)     echo "PI_WORKER=1 pi -p --no-extensions --provider zai-api --model glm-5.3-flash" ;;
    kimi)   echo "kimi -m moonshot-ai/kimi-k3 -p" ;;
    cursor) echo "cursor-agent -p --trust --model composer-2.5" ;;
    devin)  echo "env -u DEVIN_API_KEY -u DEVIN_TOKEN -u WINDSURF_API_KEY devin --model swe-1.7 --permission-mode accept-edits --respect-workspace-trust false -p --" ;;
    *) return 1 ;;
  esac
}
case "$PROVIDER" in claude|codex|gemini|pi|kimi|cursor|devin) : ;; *) echo "box-agent: unknown provider $PROVIDER" >&2; exit 2 ;; esac
if [[ "$PROVIDER" != claude && "$PROVIDER" != codex ]] && [[ -n "$MODEL" || -n "$EFFORT" ]]; then
  echo "box-agent: --model/--reasoning-effort are ignored for on-box provider '$PROVIDER' (command is hard-coded in onbox_cmd)" >&2
fi

# Resolve owner/repo.
if [[ -z "$REPO" ]]; then
  REMOTE="$(git remote get-url origin 2>/dev/null || true)"
  [[ -n "$REMOTE" ]] || { echo "box-agent: not in a git repo and no --repo given." >&2; exit 2; }
  REPO="$(printf '%s' "$REMOTE" | sed -E 's#(git@github.com:|https://github.com/)##; s#\.git$##')"
fi
# GitHub owner/repo names are case-insensitive, so match case-insensitively too.
REPO_LOWER="$(printf '%s' "$REPO" | tr '[:upper:]' '[:lower:]')"
case "$REPO_LOWER" in *mozilla*|*moz-ocho*) echo "box-agent: REFUSING work repo ($REPO). Boxes are personal-only." >&2; exit 1 ;; esac
[[ "$REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || { echo "box-agent: invalid --repo '$REPO' (want owner/name)" >&2; exit 2; }
SLUG="${REPO##*/}"
case "$SLUG" in .|..) echo "box-agent: invalid repo slug from '$REPO'" >&2; exit 2 ;; esac
DIR="/home/user/work/$SLUG"

# --- Box lifecycle ---
if [[ -n "$REUSE" ]]; then BOX="$REUSE"; echo "box-agent: reusing $BOX"; else
  echo "box-agent: starting a Box..."
  BOX="$(box new --from agent-roster-ready --environment agent-roster --json 2>/dev/null | sed -n 's/.*"id":"\(bx_[a-z0-9]*\)".*/\1/p' | head -1)"
  [[ -n "$BOX" ]] || { echo "box-agent: could not create a Box" >&2; exit 1; }
  echo "box-agent: Box=$BOX"
fi
cleanup() {
  [[ "$KEEP" -eq 1 || -n "$REUSE" ]] && { echo "box-agent: leaving $BOX running"; return; }
  echo "box-agent: stopping $BOX"; box stop "$BOX" >/dev/null 2>&1 || true
  for _ in 1 2 3 4 5; do
    # A failed/empty query is not the same as a confirmed-gone Box: retry it
    # rather than reporting false confirmation.
    LIST_JSON="$(box list --json 2>/dev/null)" || LIST_JSON=""
    if [[ -n "$LIST_JSON" ]] \
       && st="$(printf '%s' "$LIST_JSON" | jq -r --arg id "$BOX" '.[]? | select(.id==$id) | .state' 2>/dev/null | head -1)"; then
      case "$st" in
        stopping|stopped) echo "box-agent: $BOX state=$st"; return ;;
        "") echo "box-agent: $BOX state=gone"; return ;;
      esac
    fi
    sleep 2
  done
  echo "box-agent: WARNING could not confirm $BOX stopped — run 'box stop $BOX'" >&2
}
trap cleanup EXIT
READY=0
for _ in $(seq 1 40); do box exec "$BOX" --timeout 20 -- true >/dev/null 2>&1 && { READY=1; break; }; sleep 2; done
[[ "$READY" -eq 1 ]] || { echo "box-agent: $BOX never became ready — aborting." >&2; exit 1; }

if [[ "$PROVIDER" == claude || "$PROVIDER" == codex ]]; then
  # NATIVE path: the agent clones + works itself (box exec bash -lc mangles multi-
  # step strings, so setup goes in the prompt — the proven box-claude pattern).
  echo "box-agent: prompting $PROVIDER via box prompt (native)"
  MODEL_ARG=(); [[ -n "$MODEL" ]] && MODEL_ARG=(--model "$MODEL")
  EFFORT_ARG=(); [[ -n "$EFFORT" ]] && EFFORT_ARG=(--reasoning-effort "$EFFORT")
  SETUP="Using your shell: run 'mkdir -p /home/user/work && cd /home/user/work && rm -rf $SLUG && gh repo clone $REPO && cd $SLUG'. Then do this task in that repo and do NOT commit or push:"
  # codex reliably HANGS on the Box and blocks the command channel. Guard it: run
  # the prompt in the background and box-interrupt after CODEX_MAX_SECS, then fall
  # through to the verify step (which reads the diff regardless).
  if [[ "$PROVIDER" == codex ]]; then
    ( box prompt --provider codex ${MODEL_ARG[@]+"${MODEL_ARG[@]}"} ${EFFORT_ARG[@]+"${EFFORT_ARG[@]}"} --json "$BOX" "$SETUP $PROMPT" \
        > /tmp/box-agent-codex-$$.out 2>&1 ) & PP=$!
    for _ in $(seq 1 "${CODEX_MAX_SECS:-360}"); do kill -0 "$PP" 2>/dev/null || break; sleep 1; done
    if kill -0 "$PP" 2>/dev/null; then echo "box-agent: codex still running after ${CODEX_MAX_SECS:-360}s — interrupting"; box interrupt "$BOX" >/dev/null 2>&1; kill "$PP" 2>/dev/null; fi
    CODEX_LAST="$(sed -n 's/.*"content":"\(.*\)","is_reverted.*/\1/p' /tmp/box-agent-codex-$$.out 2>/dev/null | tail -1)"
    if [[ -n "$CODEX_LAST" ]]; then
      printf '%s\n' "$CODEX_LAST"
    else
      # No parsable content line means `box prompt` itself errored (bad model,
      # network, auth) before producing JSON -- that error text doesn't match
      # the sed pattern and was otherwise silently dropped, making a real
      # failure indistinguishable from "the agent made no changes".
      echo "box-agent: codex produced no parsable output; raw output:" >&2
      tail -20 /tmp/box-agent-codex-$$.out >&2 2>/dev/null
    fi
    rm -f /tmp/box-agent-codex-$$.out
  else
    # Never trust this exit code either: a failed/errored prompt call must not
    # skip the on-Box verification below, since the agent may have already
    # made edits (the box-claude lesson).
    PROMPT_RAW="$(box prompt --provider "$PROVIDER" ${MODEL_ARG[@]+"${MODEL_ARG[@]}"} ${EFFORT_ARG[@]+"${EFFORT_ARG[@]}"} --json "$BOX" \
      "$SETUP $PROMPT" 2>&1)" || true
    PROMPT_LAST="$(printf '%s' "$PROMPT_RAW" | sed -n 's/.*"content":"\(.*\)","is_reverted.*/\1/p' | tail -1)"
    if [[ -n "$PROMPT_LAST" ]]; then
      printf '%s\n' "$PROMPT_LAST"
    else
      # Same reasoning as codex above: surface the raw output instead of
      # silently falling through to a "NO diff" that could really mean
      # "box prompt failed".
      echo "box-agent: $PROVIDER prompt produced no parsable output; raw output:" >&2
      printf '%s\n' "$PROMPT_RAW" | tail -20 >&2
    fi
  fi
else
  # ON-BOX CLI path. Prove canonical github identity/access from an explicit
  # existing cwd BEFORE cloning, clone with the canonical personal token
  # (never ambient), then prove full provider readiness in the checkout
  # before the runner ships. Bootstrap failures exit 3/4 with the Box
  # stopped by the EXIT trap; they are never source defects.
  CLI="${PROVIDER}"; [[ "$PROVIDER" == cursor ]] && CLI="cursor-agent"
  have="$(box exec "$BOX" --json -- command -v "$CLI" 2>/dev/null | jq -r '.stdout' | tr -d '[:space:]')" || true
  [[ -z "$have" ]] && { echo "box-agent: $CLI not found on the Box — install/auth it there first." >&2; exit 3; }
  PROBE_BASE="${BOX_PROBE_BASE:-/home/user}"
  BOX_WORK="$PROBE_BASE/work"
  READINESS_GATE="$(cd "$(dirname "$0")" && pwd)/box-provider-readiness"
  [[ -x "$READINESS_GATE" ]] || { echo "box-agent: box-provider-readiness not found next to box-agent; refusing unwired dispatch" >&2; exit 3; }
  box exec "$BOX" -- mkdir -p "$BOX_WORK" >/dev/null 2>&1 || true
  "$READINESS_GATE" --box "$BOX" --cwd "$BOX_WORK" --repo "$REPO" --github-only || exit 3
  clone_runner="$(mktemp)"
  CLONE_REMOTE="$PROBE_BASE/box-agent-clone-$$.sh"
  cat > "$clone_runner" <<RUNNER
#!/usr/bin/env bash
set -uo pipefail
REPO="\${1:?}"; DEST="\${2:?}"; BASE="\${3:-/home/user}"
GH_F="\$BASE/.agents/github-personal.token"
[ -s "\$GH_F" ] || { echo "box-agent: canonical github token missing on the Box" >&2; exit 1; }
GH_T="\$(cat "\$GH_F")"; [ -n "\$GH_T" ] || { echo "box-agent: canonical github token empty on the Box" >&2; exit 1; }
rm -rf "\$DEST"
# git clone (not gh repo clone) against an explicit https URL: gh repo clone
# honors the Box's configured git_protocol, so a Box set to ssh would clone
# via ambient SSH credentials and ignore GH_T entirely -- the same failure
# mode box-provider-readiness's own ls-remote gate avoids by never calling gh.
exec git -c "http.extraHeader=Authorization: Bearer \$GH_T" clone "https://github.com/\$REPO.git" "\$DEST"
RUNNER
  box scp "$clone_runner" "$BOX:$CLONE_REMOTE" >/dev/null 2>&1 \
    || { rm -f "$clone_runner"; echo "box-agent: could not copy the clone runner to the Box" >&2; exit 4; }
  rm -f "$clone_runner"
  CLONE_RAW="$(box exec "$BOX" --cwd "$BOX_WORK" --json --timeout 180 -- bash "$CLONE_REMOTE" "$REPO" "$DIR" "$PROBE_BASE" 2>/dev/null)" \
    || { echo "box-agent: clone failed (transport)" >&2; exit 4; }
  CLONE_CODE="$(printf '%s' "$CLONE_RAW" | jq -r '.exitCode // 1' 2>/dev/null)" || CLONE_CODE=1
  [[ "$CLONE_CODE" = "0" ]] || { echo "box-agent: clone failed" >&2; exit 4; }
  "$READINESS_GATE" --box "$BOX" --provider "$PROVIDER" --cwd "$DIR" --repo "$REPO" || exit 3
  CMD="$(onbox_cmd "$PROVIDER")"
  echo "box-agent: running $PROVIDER CLI on the Box ($CLI) in $DIR"
  # `box exec` joins argv into a remote shell command string, so a quoted
  # `bash -lc "cd X && ..."` loses its quotes and degenerates to `bash -lc` plus
  # stray words -- box-fast-attach documents the same failure as `bash -c test`.
  # The CLI then started in the Box's default cwd, left $DIR untouched, and this
  # script reported "NO diff" as though the agent had simply done nothing.
  #
  # So do what box-work does: ship a runner script and invoke it with every
  # argument as its own shell-safe word. The prompt still travels base64-encoded
  # and is decoded on the Box, or prompt text like $(...), backticks or quotes
  # would run as remote shell syntax.
  runner="$(mktemp)"
  cat > "$runner" <<RUNNER
#!/usr/bin/env bash
export PATH="\$HOME/.local/bin:\$HOME/.kimi-code/bin:\$HOME/.npm-global/bin:\$PATH"
set -a; [ -f "\$HOME/.agents/agent-clis.env" ] && . "\$HOME/.agents/agent-clis.env"; set +a
cd "$DIR" || { echo "box-agent-run: $DIR missing on the Box" >&2; exit 1; }
P="\$(printf %s "\$1" | base64 -d)"
$CMD "\$P"
RUNNER
  box scp "$runner" "$BOX:/home/user/box-agent-run.sh" >/dev/null 2>&1 \
    || { rm -f "$runner"; echo "box-agent: could not copy the runner to the Box" >&2; exit 4; }
  rm -f "$runner"
  B64PROMPT="$(printf '%s' "$PROMPT" | base64 | tr -d '\n')"
  RUN_EXEC_ERR="$(mktemp)"
  RUN_RAW="$(box exec "$BOX" --json --timeout 600 -- bash /home/user/box-agent-run.sh "$B64PROMPT" 2>"$RUN_EXEC_ERR")" || true
  if [[ -z "$RUN_RAW" ]]; then
    # `box exec` itself failed (timeout, transport error) before returning any
    # JSON -- its own stderr was the only diagnostic, and discarding it left
    # this indistinguishable from "the CLI legitimately made no changes".
    echo "box-agent: box exec returned no output for the $PROVIDER run; box exec stderr:" >&2
    cat "$RUN_EXEC_ERR" >&2 2>/dev/null
  fi
  rm -f "$RUN_EXEC_ERR"
  printf '%s' "$RUN_RAW" | jq -r '.stdout // empty' 2>/dev/null | tail -20 || true
  RUN_ERR="$(printf '%s' "$RUN_RAW" | jq -r '.stderr // empty' 2>/dev/null)" || RUN_ERR=""
  # The preflight only checks the binary exists, not that it's authed/funded
  # (see PROVIDER STATUS above) -- surface stderr so an auth/funding failure
  # isn't indistinguishable from the CLI legitimately making no changes.
  [[ -n "$RUN_ERR" ]] && echo "box-agent: $PROVIDER CLI stderr: $RUN_ERR" >&2
fi

# --- Verify ON the Box + pull patch ---
echo "box-agent: === git diff ON the Box ($DIR) ==="
# A missing/failed clone (native path: the agent runs its own setup and may not
# have gotten to it) must not be reported as "no diff" -- that's a different,
# more actionable failure than "the agent made no changes".
if ! box exec "$BOX" --cwd "$DIR" -- true >/dev/null 2>&1; then
  echo "box-agent: $DIR not found on the Box — clone/setup likely failed; see output above." >&2
  exit 5
fi
# Mark new files intent-to-add so they show up in `git diff` too -- otherwise a
# task that only creates untracked files produces an empty diff and no patch.
box exec "$BOX" --cwd "$DIR" -- git add -N -- . >/dev/null 2>&1 || true
# --binary: without it, a patch touching a binary file can't be reapplied with
# `git apply` (the payload is simply omitted from a plain diff).
# diff HEAD, not a bare diff: a bare `git diff` only compares the working tree
# to the index, so any edits the agent already `git add`ed (fully staged, not
# just the intent-to-add above) would be invisible and wrongly read as "no diff".
if ! RAW="$(box exec "$BOX" --json --cwd "$DIR" -- git --no-pager diff HEAD --binary 2>/dev/null)" || [[ -z "$RAW" ]]; then
  echo "box-agent: could not read the diff from the Box (box exec failed) — this is a verification failure, not confirmation of no changes." >&2
  exit 6
fi
if ! DIFF="$(printf '%s' "$RAW" | jq -r '.stdout // empty' 2>/dev/null)"; then
  echo "box-agent: could not parse the diff JSON from the Box — this is a verification failure, not confirmation of no changes." >&2
  exit 6
fi
TRUNCATED="$(printf '%s' "$RAW" | jq -r '.stdoutTruncated // false' 2>/dev/null)" || TRUNCATED="false"
if [[ -z "$DIFF" ]]; then
  echo "box-agent: NO diff on the Box — the agent changed nothing."
elif [[ "$TRUNCATED" == "true" ]]; then
  # Leave the Box running: the cleanup trap stops it on EXIT by default, which
  # would make the "pull it manually" instruction below unusable seconds later.
  KEEP=1
  echo "box-agent: diff on the Box was TRUNCATED — refusing to save a partial patch." >&2
  echo "box-agent: leaving $BOX running — pull it manually:  box exec $BOX --cwd $DIR -- git diff" >&2
  exit 7
else
  PATCH="$(mktemp "/tmp/box-agent-$SLUG-XXXXXX.patch")"; printf '%s\n' "$DIFF" > "$PATCH"
  # Preview from the file, not a pipe from $DIFF: under `set -o pipefail`, a
  # diff bigger than head's read means the producer gets SIGPIPE and set -e
  # would abort the script before the "full diff ->" line below ever prints.
  head -40 "$PATCH"
  echo "box-agent: full diff -> $PATCH  (apply: git apply \"$PATCH\")"
fi
echo "box-agent: done"
