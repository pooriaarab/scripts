#!/usr/bin/env python3
"""Plan isolated Cloudflare Worker Preview resources without mutating them."""
import argparse
import hashlib
import json
import os
import re
import sys
import tempfile
from pathlib import Path

WORKFLOW = "Worker Preview Build"
ARTIFACT = "worker-preview-bundle"
PIN_KEYS = {
    "schema", "repository", "pull_request", "branch", "head_sha", "workflow",
    "run_id", "artifact", "artifact_id", "artifact_digest",
}
CONFIG_KEYS = {"schema", "repository", "prefix", "worker_name", "workers_dev",
               "preview_domain", "bindings"}
BINDING_KINDS = ("d1", "kv", "r2")
NAME_LIMITS = {"d1": 32, "kv": 512, "r2": 63, "access": 350,
               "policy": 350, "ci": 350, "test-user": 350}
REPOSITORY = re.compile(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+")
SHA = re.compile(r"[0-9a-f]{40}")
DIGEST = re.compile(r"sha256:[0-9a-f]{64}")
BINDING = re.compile(r"[A-Z][A-Z0-9_]{0,62}")
DNS_LABEL = re.compile(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?")
WORKER_NAME = re.compile(r"[A-Za-z0-9-]{1,255}")
MAX_INPUT = 1024 * 1024


class PlanError(Exception):
    pass


def object_without_duplicates(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise PlanError(f"duplicate JSON key: {key}")
        value[key] = item
    return value


def load_json(path, label):
    try:
        if path.is_symlink() or not path.is_file() or path.stat().st_size > MAX_INPUT:
            raise PlanError(f"{label} must be a regular JSON file of at most 1 MiB")
        value = json.loads(path.read_bytes(), object_pairs_hook=object_without_duplicates)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
        raise PlanError(f"{label} is not valid UTF-8 JSON") from error
    if not isinstance(value, dict):
        raise PlanError(f"{label} root must be an object")
    return value


def positive_integer(value, label):
    if type(value) is not int or value < 1:
        raise PlanError(f"{label} must be a positive integer")


def validate_pin(pin):
    if set(pin) != PIN_KEYS or type(pin.get("schema")) is not int or pin["schema"] != 1:
        raise PlanError("verified pin has an unexpected schema")
    if not isinstance(pin["repository"], str) or not REPOSITORY.fullmatch(pin["repository"]):
        raise PlanError("verified pin repository is invalid")
    positive_integer(pin["pull_request"], "pull request")
    positive_integer(pin["run_id"], "workflow run ID")
    positive_integer(pin["artifact_id"], "artifact ID")
    if not isinstance(pin["head_sha"], str) or not SHA.fullmatch(pin["head_sha"]):
        raise PlanError("verified pin head SHA is invalid")
    if not isinstance(pin["artifact_digest"], str) or not DIGEST.fullmatch(pin["artifact_digest"]):
        raise PlanError("verified pin artifact digest is invalid")
    if pin["workflow"] != WORKFLOW or pin["artifact"] != ARTIFACT:
        raise PlanError("verified pin names an unexpected workflow or artifact")
    if not isinstance(pin["branch"], str):
        raise PlanError("verified pin branch is invalid")


def validate_domain(value):
    if not isinstance(value, str) or len(value) > 253 or value.endswith("."):
        raise PlanError("preview domain is invalid")
    labels = value.split(".")
    if len(labels) < 3 or not all(DNS_LABEL.fullmatch(label) for label in labels):
        raise PlanError("preview domain is invalid")
    offset = 2 if labels[:2] == ["preview", "staging"] else 1
    if labels[0] != "preview" or len(labels[offset:]) < 2:
        raise PlanError("preview domain must be preview.<domain> or preview.staging.<domain>")
    return value


def validate_config(config, pin):
    if (set(config) != CONFIG_KEYS or type(config.get("schema")) is not int
            or config["schema"] != 1):
        raise PlanError("trusted configuration has an unexpected schema")
    if config["repository"] != pin["repository"]:
        raise PlanError("trusted configuration does not match the verified repository")
    prefix = config["prefix"]
    if not isinstance(prefix, str) or not re.fullmatch(r"[a-z]{2,4}", prefix):
        raise PlanError("trusted repository prefix is invalid")
    worker_name, workers_dev = config["worker_name"], config["workers_dev"]
    if (not isinstance(worker_name, str) or not WORKER_NAME.fullmatch(worker_name)
            or type(workers_dev) is not bool
            or workers_dev and (len(worker_name) > 63 or worker_name.startswith("-")
                                or worker_name.endswith("-"))):
        raise PlanError("trusted Worker name is invalid")
    pattern = rf"{re.escape(prefix)}-([1-9][0-9]*)-([a-z0-9]+(?:-[a-z0-9]+)*)"
    match = re.fullmatch(pattern, pin["branch"])
    if (len(pin["branch"]) > 63 or not match
            or not 3 <= len(match.group(2)) <= 48):
        raise PlanError("verified branch does not meet the trusted PR standard")
    domain = validate_domain(config["preview_domain"])
    hostname = f"{pin['branch']}.{domain}"
    if len(hostname) > 253:
        raise PlanError("derived Preview hostname exceeds the DNS hostname limit")
    bindings = config["bindings"]
    if not isinstance(bindings, dict) or set(bindings) != set(BINDING_KINDS):
        raise PlanError("trusted bindings need exact d1, kv, and r2 lists")
    seen = set()
    for kind in BINDING_KINDS:
        values = bindings[kind]
        if not isinstance(values, list) or len(values) > 64 or any(
                not isinstance(item, str) or not BINDING.fullmatch(item) for item in values):
            raise PlanError(f"trusted {kind} bindings contain an invalid name")
        if len(values) != len(set(values)) or seen.intersection(values):
            raise PlanError("trusted binding names must be unique")
        seen.update(values)
    return domain, hostname


def resource_name(repository, branch, kind, binding=None):
    suffix = kind if binding is None else f"{kind}-{binding.lower().replace('_', '-')}"
    namespace = hashlib.sha256(repository.encode()).hexdigest()[:16]
    candidate = f"{branch}-{namespace}-{suffix}"
    limit = NAME_LIMITS[kind]
    if len(candidate) <= limit:
        return candidate
    digest = hashlib.sha256(candidate.encode()).hexdigest()[:16]
    branch_part = branch[:limit - len(kind) - len(digest) - 2].rstrip("-")
    return f"{branch_part}-{kind}-{digest}"


def plan(pin, config):
    validate_pin(pin)
    domain, hostname = validate_config(config, pin)
    branch, repository = pin["branch"], pin["repository"]
    intended = {
        "target_worker": {"name": config["worker_name"], "workers_dev": config["workers_dev"]},
        "preview": {"name": branch, "hostname": hostname, "preview_domain": domain},
        **{kind: [{"binding": binding, "name": resource_name(repository, branch, kind, binding)}
                  for binding in config["bindings"][kind]] for kind in BINDING_KINDS},
        "access": {
            "application_name": resource_name(repository, branch, "access"),
            "hostname": hostname,
            "policy_name": resource_name(repository, branch, "policy"),
            "service_token_name": resource_name(repository, branch, "ci"),
        },
        "test_identity": {"name": resource_name(repository, branch, "test-user")},
    }
    acquired = {
        "preview": {"version_id": None},
        **{kind: {item["binding"]: {"id" if kind != "r2" else "name": None}
                  for item in intended[kind]} for kind in BINDING_KINDS},
        "access": {"application_id": None, "policy_id": None, "service_token_id": None},
        "test_identity": {"id": None},
    }
    owner = {key: pin[key] for key in (
        "repository", "pull_request", "branch", "head_sha", "workflow", "run_id",
        "artifact", "artifact_id", "artifact_digest")}
    return {"schema": 1, "owner": owner, "intended": intended, "acquired": acquired}


def publish(path, manifest):
    raw = path.expanduser()
    if raw.is_symlink():
        raise PlanError("output must not be a symbolic link")
    parent, name = raw.parent.resolve(), raw.name
    if not name or not parent.is_dir():
        raise PlanError("output parent must be an existing directory")
    destination = parent / name
    if os.path.lexists(destination):
        raise PlanError("output already exists")
    data = (json.dumps(manifest, sort_keys=True, separators=(",", ":")) + "\n").encode()
    temporary = tempfile.NamedTemporaryFile(prefix=f".{name}.", dir=parent, delete=False)
    try:
        with temporary:
            os.fchmod(temporary.fileno(), 0o600)
            temporary.write(data)
            temporary.flush()
            os.fsync(temporary.fileno())
        directory = os.open(parent, os.O_RDONLY)
        try:
            try:
                os.link(temporary.name, destination)
            except FileExistsError as error:
                raise PlanError("output appeared during publication") from error
            try:
                os.fsync(directory)
            except OSError:
                destination.unlink(missing_ok=True)
                raise
        finally:
            os.close(directory)
    finally:
        Path(temporary.name).unlink(missing_ok=True)
    return destination


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("verified_pin", type=Path)
    parser.add_argument("trusted_config", type=Path)
    parser.add_argument("output", type=Path)
    args = parser.parse_args()
    try:
        manifest = plan(load_json(args.verified_pin, "verified pin"),
                        load_json(args.trusted_config, "trusted configuration"))
        output = publish(args.output, manifest)
    except (PlanError, OSError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    print(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
